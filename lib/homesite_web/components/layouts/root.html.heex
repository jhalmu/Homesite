<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <SEO.juice
      conn={@conn}
      config={HomesiteWeb.SEO.config()}
      page_title={assigns[:page_title]}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <%!-- Feed Discovery - RSS, Atom, and JSON --%>
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Orangedinos - RSS Feed"
      href={url(~p"/rss.xml")}
    />
    <link
      rel="alternate"
      type="application/atom+xml"
      title="Orangedinos - Atom Feed"
      href={url(~p"/feed.xml")}
    />
    <link
      rel="alternate"
      type="application/feed+json"
      title="Orangedinos - JSON Feed"
      href={url(~p"/feed.json")}
    />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <%!-- Cloudflare Turnstile CAPTCHA --%>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer>
    </script>
    <script>
      (() => {
        const getSystemTheme = () => {
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        };

        const setTheme = (theme) => {
          // If "system", detect OS preference and apply it
          if (theme === "system") {
            const systemTheme = getSystemTheme();
            document.documentElement.setAttribute("data-theme", systemTheme);
            localStorage.setItem("phx:theme", "system");
            return;
          }

          // Otherwise apply explicit theme
          document.documentElement.setAttribute("data-theme", theme);
          localStorage.setItem("phx:theme", theme);
        };

        // Initialize theme on page load
        const savedTheme = localStorage.getItem("phx:theme");

        if (!savedTheme) {
          // New user: detect system preference and apply it as default
          const systemTheme = getSystemTheme();
          document.documentElement.setAttribute("data-theme", systemTheme);
          // Don't save to localStorage - let user explicitly choose if they want to override
        } else {
          // Existing user: apply their saved preference
          setTheme(savedTheme);
        }

        // Listen for system theme changes (OS dark mode toggle)
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
          const savedTheme = localStorage.getItem("phx:theme");
          // Only auto-switch if user chose "system" or hasn't set preference
          if (!savedTheme || savedTheme === "system") {
            setTheme("system");
          }
        });

        // Listen for storage changes (theme changed in another tab)
        window.addEventListener("storage", (e) => {
          if (e.key === "phx:theme") {
            setTheme(e.newValue || "system");
          }
        });

        // Listen for theme button clicks
        window.addEventListener("phx:set-theme", (e) => setTheme(e.detail.theme));
      })();

      // Locale management
      (() => {
        const setLocaleCookie = (locale) => {
          // Set cookie for server-side reading (1 year expiration)
          const expires = new Date();
          expires.setFullYear(expires.getFullYear() + 1);
          document.cookie = `locale=${locale}; path=/; expires=${expires.toUTCString()}; SameSite=Lax`;
        };

        const getLocaleCookie = () => {
          const match = document.cookie.match(/(?:^|;\s*)locale=([^;]*)/);
          return match ? match[1] : null;
        };

        const setLocale = (locale) => {
          localStorage.setItem("phx:locale", locale);
          setLocaleCookie(locale);
          document.documentElement.setAttribute("lang", locale);
          document.documentElement.setAttribute("data-locale", locale);
          // Reload page to apply new locale (LiveView limitation)
          window.location.reload();
        };

        // Set initial locale from cookie, localStorage, or default to 'fi'
        const savedLocale = getLocaleCookie() || localStorage.getItem("phx:locale") || "fi";
        document.documentElement.setAttribute("lang", savedLocale);
        document.documentElement.setAttribute("data-locale", savedLocale);

        // If no cookie exists, set it to match localStorage or default
        if (!getLocaleCookie()) {
          setLocaleCookie(savedLocale);
        }

        window.addEventListener("storage", (e) => e.key === "phx:locale" && setLocale(e.newValue || "fi"));
        window.addEventListener("phx:set-locale", (e) => setLocale(e.target.dataset.phxLocale));
      })();
    </script>
    <%!-- JSON-LD Structured Data --%>
    <%= if assigns[:json_ld] do %>
      <script type="application/ld+json">
        <%= raw(assigns.json_ld) %>
      </script>
    <% end %>
  </head>
  <body>
    <%!-- Skip link for keyboard navigation (WCAG 2.4.1) --%>
    <a
      href="#main-content"
      class="sr-only focus:bg-primary focus:text-primary-content focus:ring-primary focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:px-4 focus:py-2 focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-offset-2"
    >
      {gettext("Skip to main content")}
    </a>
    <Layouts.navbar current_scope={@current_scope} />
    {@inner_content}
  </body>
</html>
