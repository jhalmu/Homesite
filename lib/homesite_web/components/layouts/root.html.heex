<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Homesite" suffix=" · Phoenix Framework">
      {assigns[:page_title]}
    </.live_title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <%!-- Feed Discovery - RSS, Atom, and JSON --%>
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Homesite - RSS Feed"
      href={url(~p"/rss.xml")}
    />
    <link
      rel="alternate"
      type="application/atom+xml"
      title="Homesite - Atom Feed"
      href={url(~p"/feed.xml")}
    />
    <link
      rel="alternate"
      type="application/feed+json"
      title="Homesite - JSON Feed"
      href={url(~p"/feed.json")}
    />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.removeAttribute("data-theme");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));
      })();

      // Locale management
      (() => {
        const setLocaleCookie = (locale) => {
          // Set cookie for server-side reading (1 year expiration)
          const expires = new Date();
          expires.setFullYear(expires.getFullYear() + 1);
          document.cookie = `locale=${locale}; path=/; expires=${expires.toUTCString()}; SameSite=Lax`;
        };

        const getLocaleCookie = () => {
          const match = document.cookie.match(/(?:^|;\s*)locale=([^;]*)/);
          return match ? match[1] : null;
        };

        const setLocale = (locale) => {
          localStorage.setItem("phx:locale", locale);
          setLocaleCookie(locale);
          document.documentElement.setAttribute("lang", locale);
          document.documentElement.setAttribute("data-locale", locale);
          // Reload page to apply new locale (LiveView limitation)
          window.location.reload();
        };

        // Set initial locale from cookie, localStorage, or default to 'fi'
        const savedLocale = getLocaleCookie() || localStorage.getItem("phx:locale") || "fi";
        document.documentElement.setAttribute("lang", savedLocale);
        document.documentElement.setAttribute("data-locale", savedLocale);

        // If no cookie exists, set it to match localStorage or default
        if (!getLocaleCookie()) {
          setLocaleCookie(savedLocale);
        }

        window.addEventListener("storage", (e) => e.key === "phx:locale" && setLocale(e.newValue || "fi"));
        window.addEventListener("phx:set-locale", (e) => setLocale(e.target.dataset.phxLocale));
      })();
    </script>
    <%!-- JSON-LD Structured Data --%>
    <%= if assigns[:json_ld] do %>
      <script type="application/ld+json">
        <%= raw(assigns.json_ld) %>
      </script>
    <% end %>
  </head>
  <body>
    <Layouts.navbar current_scope={@current_scope} />
    {@inner_content}
  </body>
</html>
