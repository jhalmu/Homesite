<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="technical-main">
    <.header>
      {gettext("Feed Folders")}
      <:subtitle>
        {gettext("Organize your feed sources into folders")}
      </:subtitle>
      <:actions>
        <button phx-click="new_folder" class="btn btn-primary btn-sm">
          <.icon name="hero-folder-plus" class="h-5 w-5" />
          {gettext("New Folder")}
        </button>
      </:actions>
    </.header>
    
<!-- New/Edit Folder Form -->
    <%= if @editing_folder_id do %>
      <div class="card bg-base-100 my-[var(--space-md)] shadow-md">
        <div class="card-body">
          <h3 class="card-title">
            {if @editing_folder_id == :new,
              do: gettext("New Folder"),
              else: gettext("Edit Folder")}
          </h3>

          <.form for={@form} phx-submit="save_folder" class="space-y-[var(--space-sm)]">
            <.input
              field={@form[:name]}
              type="text"
              label={gettext("Folder Name")}
              placeholder={gettext("e.g., Tech News, Friends, Videos")}
              required
            />

            <div class="grid grid-cols-2 gap-[var(--space-sm)]">
              <.input
                field={@form[:icon]}
                type="text"
                label={gettext("Icon (emoji)")}
                placeholder="📁"
              />

              <.input
                field={@form[:color]}
                type="text"
                label={gettext("Color")}
                placeholder="primary, secondary, accent"
              />
            </div>

            <.input
              field={@form[:display_order]}
              type="number"
              label={gettext("Display Order")}
              placeholder="0"
            />

            <div class="card-actions justify-end gap-[var(--space-xs)]">
              <button type="button" phx-click="cancel_edit" class="btn btn-ghost">
                {gettext("Cancel")}
              </button>
              <button type="submit" class="btn btn-primary">
                {gettext("Save")}
              </button>
            </div>
          </.form>
        </div>
      </div>
    <% end %>
    
<!-- Folders List -->
    <div class="mt-[var(--space-md)] space-y-[var(--space-sm)]">
      <%= if Enum.empty?(@folders) do %>
        <div class="alert">
          <.icon name="hero-information-circle" class="h-6 w-6" />
          <span>
            {gettext("No folders yet. Create one to organize your feed sources!")}
          </span>
        </div>
      <% else %>
        <%= for folder <- @folders do %>
          <div class="card bg-base-100 border-base-300 border shadow-sm">
            <div class="card-body">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-[var(--space-sm)]">
                  <span class="text-3xl">{folder.icon || "📁"}</span>
                  <div>
                    <h3 class="card-title text-[var(--text-lg)]">{folder.name}</h3>
                    <%= if folder.color do %>
                      <span class={"badge-#{folder.color} badge badge-sm"}>
                        {folder.color}
                      </span>
                    <% end %>
                  </div>
                </div>

                <div class="card-actions">
                  <button
                    phx-click="edit_folder"
                    phx-value-id={folder.id}
                    class="btn btn-ghost btn-sm"
                    title={gettext("Edit folder")}
                  >
                    <.icon name="hero-pencil" class="h-4 w-4" />
                  </button>

                  <button
                    phx-click="delete_folder"
                    phx-value-id={folder.id}
                    data-confirm={gettext("Are you sure you want to delete this folder?")}
                    class="btn btn-ghost btn-sm text-error"
                    title={gettext("Delete folder")}
                  >
                    <.icon name="hero-trash" class="h-4 w-4" />
                  </button>
                </div>
              </div>

<!-- Display order badge -->
              <%= if folder.display_order != 0 do %>
                <div class="text-base-content/60 text-[var(--text-sm)]">
                  {gettext("Order: %{order}", order: folder.display_order)}
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>

<!-- Back to Feeds link -->
    <div class="mt-[var(--space-md)]">
      <.link navigate={~p"/feeds"} class="btn btn-ghost btn-sm">
        <.icon name="hero-arrow-left" class="h-4 w-4" />
        {gettext("Back to Feed Sources")}
      </.link>
    </div>
  </div>
</Layouts.app>
