<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-4xl mx-auto px-4 py-8">
    <.header>
      <%= gettext("Feed Folders") %>
      <:subtitle>
        <%= gettext("Organize your feed sources into folders") %>
      </:subtitle>
      <:actions>
        <button phx-click="new_folder" class="btn btn-primary btn-sm">
          <.icon name="hero-folder-plus" class="w-5 h-5" />
          <%= gettext("New Folder") %>
        </button>
      </:actions>
    </.header>

    <!-- New/Edit Folder Form -->
    <%= if @editing_folder_id do %>
      <div class="card bg-base-100 shadow-md my-6">
        <div class="card-body">
          <h3 class="card-title">
            <%= if @editing_folder_id == :new, do: gettext("New Folder"), else: gettext("Edit Folder") %>
          </h3>

          <.form for={@form} phx-submit="save_folder" class="space-y-4">
            <.input
              field={@form[:name]}
              type="text"
              label={gettext("Folder Name")}
              placeholder={gettext("e.g., Tech News, Friends, Videos")}
              required
            />

            <div class="grid grid-cols-2 gap-4">
              <.input
                field={@form[:icon]}
                type="text"
                label={gettext("Icon (emoji)")}
                placeholder="📁"
              />

              <.input
                field={@form[:color]}
                type="text"
                label={gettext("Color")}
                placeholder="primary, secondary, accent"
              />
            </div>

            <.input
              field={@form[:display_order]}
              type="number"
              label={gettext("Display Order")}
              placeholder="0"
            />

            <div class="card-actions justify-end gap-2">
              <button type="button" phx-click="cancel_edit" class="btn btn-ghost">
                <%= gettext("Cancel") %>
              </button>
              <button type="submit" class="btn btn-primary">
                <%= gettext("Save") %>
              </button>
            </div>
          </.form>
        </div>
      </div>
    <% end %>

    <!-- Folders List -->
    <div class="space-y-4 mt-6">
      <%= if Enum.empty?(@folders) do %>
        <div class="alert">
          <.icon name="hero-information-circle" class="w-6 h-6" />
          <span>
            <%= gettext("No folders yet. Create one to organize your feed sources!") %>
          </span>
        </div>
      <% else %>
        <%= for folder <- @folders do %>
          <div class="card bg-base-100 shadow-sm border border-base-300">
            <div class="card-body">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <span class="text-3xl"><%= folder.icon || "📁" %></span>
                  <div>
                    <h3 class="card-title text-lg"><%= folder.name %></h3>
                    <%= if folder.color do %>
                      <span class={"badge badge-#{folder.color} badge-sm"}>
                        <%= folder.color %>
                      </span>
                    <% end %>
                  </div>
                </div>

                <div class="card-actions">
                  <button
                    phx-click="edit_folder"
                    phx-value-id={folder.id}
                    class="btn btn-ghost btn-sm"
                    title={gettext("Edit folder")}
                  >
                    <.icon name="hero-pencil" class="w-4 h-4" />
                  </button>

                  <button
                    phx-click="delete_folder"
                    phx-value-id={folder.id}
                    data-confirm={gettext("Are you sure you want to delete this folder?")}
                    class="btn btn-ghost btn-sm text-error"
                    title={gettext("Delete folder")}
                  >
                    <.icon name="hero-trash" class="w-4 h-4" />
                  </button>
                </div>
              </div>

              <!-- Display order badge -->
              <%= if folder.display_order != 0 do %>
                <div class="text-sm text-base-content/60">
                  <%= gettext("Order: %{order}", order: folder.display_order) %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>

    <!-- Back to Feeds link -->
    <div class="mt-8">
      <.link navigate={~p"/feeds"} class="btn btn-ghost btn-sm">
        <.icon name="hero-arrow-left" class="w-4 h-4" />
        <%= gettext("Back to Feed Sources") %>
      </.link>
    </div>
  </div>
</Layouts.app>
