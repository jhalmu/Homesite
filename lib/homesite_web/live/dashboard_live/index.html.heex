<Layouts.app flash={@flash} current_scope={@current_scope}>
  <!-- Warning Banners from Moderation -->
  <%= if @active_banners != [] do %>
    <div class="space-y-[var(--space-sm)] mb-[var(--spacing-section)]">
      <%= for banner <- @active_banners do %>
        <div
          class={["alert shadow-lg", banner_alert_class(banner.severity)]}
          id={"banner-#{banner.id}"}
        >
          <div class="flex-1">
            <div class="gap-[var(--space-sm)] flex items-start">
              <.icon name={banner_icon(banner.severity)} class="h-6 w-6 flex-shrink-0" />
              <div class="flex-1">
                <p class="whitespace-pre-wrap font-medium">{banner.message}</p>
                <p class="text-[var(--text-xs)] mt-[var(--space-xs)] opacity-70">
                  {gettext("From: %{admin}",
                    admin: banner.created_by.display_name || banner.created_by.email
                  )} · {Calendar.strftime(banner.inserted_at, "%Y-%m-%d %H:%M")}
                </p>
              </div>
            </div>
          </div>
          <button
            phx-click="dismiss_banner"
            phx-value-id={banner.id}
            class="btn btn-sm btn-ghost"
            title={gettext("Dismiss")}
          >
            <.icon name="hero-x-mark" class="h-5 w-5" />
          </button>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="technical-main">
    <!-- Header -->
    <header class="gap-[var(--spacing-md)] mb-[var(--spacing-section)] flex flex-col">
      <h1 class="text-[var(--font-size-fluid-2xl)] font-bold">
        {gettext("Welcome back")}, {@current_scope.user.display_name ||
          String.split(@current_scope.user.email, "@") |> List.first()}!
      </h1>
      
<!-- Your Public Profile Card -->
      <div class="card from-primary/10 to-secondary/10 border-primary/20 mb-[var(--spacing-md)] border-2 bg-gradient-to-br">
        <div class="card-body">
          <h2 class="card-title text-[var(--text-2xl)]">
            <.icon name="hero-user-circle" class="h-8 w-8" />
            {gettext("Your Public Profile")}
          </h2>

          <%= if @current_scope.user.username do %>
            <!-- Has Username -->
            <div class="space-y-[var(--space-sm)]">
              <p class="text-base-content/70">
                {gettext("Your personal homepage is live! Share it with the world.")}
              </p>

              <div class="bg-base-100 border-base-300 p-[var(--space-sm)] rounded-lg border">
                <div class="gap-[var(--space-xs)] flex items-center">
                  <code class="text-[var(--text-sm)] flex-1 overflow-x-auto">
                    {url(~p"/users/@#{@current_scope.user.username}")}
                  </code>
                  <button
                    type="button"
                    id="copy-profile-url"
                    phx-hook="CopyButton"
                    data-clipboard-text={url(~p"/users/@#{@current_scope.user.username}")}
                    class="btn btn-sm btn-primary"
                  >
                    <.icon name="hero-clipboard" class="h-4 w-4" />
                    {gettext("Copy")}
                  </button>
                  <.link
                    navigate={~p"/users/@#{@current_scope.user.username}"}
                    class="btn btn-sm btn-outline"
                  >
                    <.icon name="hero-eye" class="h-4 w-4" />
                    {gettext("View")}
                  </.link>
                </div>
              </div>
              
<!-- Profile Stats -->
              <div class="stats stats-horizontal w-full shadow">
                <div class="stat">
                  <div class="stat-title">{gettext("Published Posts")}</div>
                  <div class="stat-value text-[var(--text-2xl)]">
                    {@profile_stats.published_count}
                  </div>
                </div>
                <div class="stat">
                  <div class="stat-title">{gettext("Total Views")}</div>
                  <div class="stat-value text-[var(--text-2xl)]">
                    {if @profile_stats.total_views, do: @profile_stats.total_views, else: "N/A"}
                  </div>
                </div>
                <div class="stat">
                  <div class="stat-title">{gettext("RSS Subscribers")}</div>
                  <div class="stat-value text-[var(--text-2xl)]">
                    {if @profile_stats.subscribers, do: @profile_stats.subscribers, else: "N/A"}
                  </div>
                </div>
              </div>
            </div>
          <% else %>
            <!-- No Username -->
            <div class="space-y-[var(--space-sm)]">
              <p class="text-[var(--text-lg)]">
                🎉 {gettext("Claim your username to create your personal homepage!")}
              </p>

              <ul class="text-base-content/70 space-y-[var(--space-xs)]">
                <li class="gap-[var(--space-xs)] flex items-start">
                  <.icon name="hero-check-circle" class="text-success mt-0.5 h-5 w-5" />
                  <span>
                    {gettext("Get a memorable URL like")}
                    <code>yoursite.com/users/@yourname</code>
                  </span>
                </li>
                <li class="gap-[var(--space-xs)] flex items-start">
                  <.icon name="hero-check-circle" class="text-success mt-0.5 h-5 w-5" />
                  <span>{gettext("Share your blog with a professional link")}</span>
                </li>
                <li class="gap-[var(--space-xs)] flex items-start">
                  <.icon name="hero-check-circle" class="text-success mt-0.5 h-5 w-5" />
                  <span>{gettext("RSS feeds with your custom username")}</span>
                </li>
              </ul>

              <.link navigate={~p"/users/settings"} class="btn btn-primary btn-block">
                <.icon name="hero-sparkles" class="h-5 w-5" />
                {gettext("Claim Your Username")}
              </.link>
            </div>
          <% end %>
        </div>
      </div>

      <div class="gap-[var(--spacing-md)] flex flex-wrap">
        <!-- Stats Cards -->
        <.dashboard_card variant="stat" class="stats">
          <div class="stat">
            <div class="stat-title">{gettext("Total Posts")}</div>
            <div class="stat-value text-primary">{@post_count}</div>
            <div class="stat-desc">
              {gettext("%{published} published, %{draft} drafts",
                published: @published_count,
                draft: @draft_count
              )}
            </div>
            <div class="stat-actions">
              <.link navigate={~p"/posts"} class="btn btn-sm btn-primary">
                {gettext("View all")}
              </.link>
            </div>
          </div>
        </.dashboard_card>

        <.dashboard_card variant="stat" class="stats">
          <div class="stat">
            <div class="stat-title">{gettext("Total Tags")}</div>
            <div class="stat-value text-secondary">{@tag_count}</div>
            <div class="stat-actions">
              <.link navigate={~p"/tags"} class="btn btn-sm btn-secondary">
                {gettext("View all")}
              </.link>
            </div>
          </div>
        </.dashboard_card>

        <.dashboard_card variant="stat" class="stats">
          <div class="stat">
            <div class="stat-title">{gettext("Feed Sources")}</div>
            <div class="stat-value text-accent">{@feed_count}</div>
            <div class="stat-desc">
              {gettext("%{enabled} enabled, %{disabled} disabled",
                enabled: @enabled_feeds,
                disabled: @disabled_feeds
              )}
            </div>
            <div class="stat-actions">
              <.link navigate={~p"/feeds"} class="btn btn-sm btn-accent">
                {gettext("View all")}
              </.link>
            </div>
          </div>
        </.dashboard_card>

        <%!-- Projects Stats --%>
        <.dashboard_card variant="stat" class="stats">
          <div class="stat">
            <div class="stat-title">{gettext("Projects")}</div>
            <div class="stat-value text-info">{@media_stats.projects.total}</div>
            <div class="stat-desc">
              {gettext("%{portfolios} portfolios, %{libraries} libraries",
                portfolios: @media_stats.projects.portfolios,
                libraries: @media_stats.projects.libraries
              )}
            </div>
            <div class="stat-actions">
              <.link navigate={~p"/projects"} class="btn btn-sm btn-info">
                {gettext("View all")}
              </.link>
            </div>
          </div>
        </.dashboard_card>

        <%!-- Media Stats --%>
        <.dashboard_card variant="stat" class="stats">
          <div class="stat">
            <div class="stat-title">{gettext("Media Library")}</div>
            <div class="stat-value text-warning">{@media_stats.media.total}</div>
            <div class="stat-desc">
              {gettext("%{size} total", size: @media_stats.media.total_size_formatted)}
            </div>
            <div class="stat-actions">
              <.link navigate={~p"/media"} class="btn btn-sm btn-warning">
                {gettext("View all")}
              </.link>
            </div>
          </div>
        </.dashboard_card>
      </div>
    </header>

    <%!-- Recent Activities --%>
    <%= if length(@activities) > 0 do %>
      <section class="mb-[var(--spacing-section)]">
        <h2 class="text-[var(--font-size-fluid-xl)] mb-[var(--spacing-md)] font-semibold">
          {gettext("Recent Activity")}
        </h2>
        <div class="space-y-[var(--space-xs)]">
          <%= for activity <- @activities do %>
            <.dashboard_card variant="activity">
              <div class="gap-[var(--space-xs)] flex items-center">
                <%= if activity.activity_type == "blog_published" do %>
                  <.icon name="hero-document-check" class="text-success h-5 w-5" />
                <% else %>
                  <.icon name="hero-document-text" class="text-info h-5 w-5" />
                <% end %>
                <span class="font-medium">{activity.content}</span>
              </div>
              <div class="text-secondary mt-[var(--space-inline)] text-[var(--text-sm)]">
                {format_datetime(activity.inserted_at)}
              </div>
            </.dashboard_card>
          <% end %>
        </div>
      </section>
    <% end %>

    <%!-- Feed Analytics Section --%>
    <%= if @feed_stats.total_feeds > 0 do %>
      <section class="mb-[var(--spacing-section)]">
        <div class="mb-[var(--spacing-md)] flex items-center justify-between">
          <h2 class="text-[var(--font-size-fluid-xl)] font-semibold">
            {gettext("Feed Analytics")}
          </h2>
          <.link navigate={~p"/feed"} class="link link-primary">
            {gettext("View Feed")} →
          </.link>
        </div>

        <div class="gap-[var(--spacing-sm)] grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4">
          <div class="stat bg-base-200 rounded-lg">
            <div class="stat-title">{gettext("Total Items")}</div>
            <div class="stat-value text-primary">{@feed_stats.total_items}</div>
            <div class="stat-desc">{@feed_stats.unread_count} {gettext("unread")}</div>
          </div>

          <div class="stat bg-base-200 rounded-lg">
            <div class="stat-title">{gettext("Read Today")}</div>
            <div class="stat-value text-secondary">{@feed_stats.read_today}</div>
            <div class="stat-desc">{@feed_stats.read_this_week} {gettext("this week")}</div>
          </div>

          <div class="stat bg-base-200 rounded-lg">
            <div class="stat-title">{gettext("Bookmarks")}</div>
            <div class="stat-value text-accent">{@feed_stats.bookmarked_count}</div>
          </div>

          <div class="stat bg-base-200 rounded-lg">
            <div class="stat-title">{gettext("Active Sources")}</div>
            <div class="stat-value">{@feed_stats.total_feeds}</div>
          </div>
        </div>

        <%!-- Top Sources --%>
        <%= if length(@feed_stats.top_sources) > 0 do %>
          <div class="mt-[var(--spacing-md)]">
            <h3 class="mb-[var(--space-xs)] text-[var(--text-lg)] font-semibold">
              {gettext("Top Sources")}
            </h3>
            <div class="space-y-[var(--space-xs)]">
              <%= for source <- Enum.take(@feed_stats.top_sources, 3) do %>
                <div class="bg-base-200 p-[var(--space-xs)] flex items-center justify-between rounded-lg">
                  <div class="gap-[var(--space-xs)] flex items-center">
                    <.icon name="hero-rss" class="h-5 w-5" />
                    <span class="font-medium">{source.source.name}</span>
                  </div>
                  <div class="text-base-content/70 text-[var(--text-sm)]">
                    {source.read_count} {gettext("read")} · {source.bookmark_count} {gettext(
                      "bookmarked"
                    )}
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </section>
    <% end %>
    
<!-- Quick Actions -->
    <section class="mb-[var(--spacing-section)]">
      <h2 class="text-[var(--font-size-fluid-xl)] mb-[var(--spacing-md)] font-semibold">
        {gettext("Quick Actions")}
      </h2>
      <div class="gap-[var(--spacing-sm)] flex flex-wrap">
        <.link navigate={~p"/posts/new"} class="btn btn-primary gap-[var(--space-xs)]">
          <.icon name="hero-plus" class="h-5 w-5" /> {gettext("New Post")}
        </.link>
        <.link navigate={~p"/projects/new"} class="btn btn-info gap-[var(--space-xs)]">
          <.icon name="hero-folder-plus" class="h-5 w-5" /> {gettext("New Project")}
        </.link>
        <.link navigate={~p"/media"} class="btn btn-warning gap-[var(--space-xs)]">
          <.icon name="hero-photo" class="h-5 w-5" /> {gettext("Upload Media")}
        </.link>
        <.link navigate={~p"/tags/new"} class="btn btn-secondary gap-[var(--space-xs)]">
          <.icon name="hero-plus" class="h-5 w-5" /> {gettext("New Tag")}
        </.link>
        <.link navigate={~p"/feeds/new"} class="btn btn-accent gap-[var(--space-xs)]">
          <.icon name="hero-rss" class="h-5 w-5" /> {gettext("New Feed Source")}
        </.link>
        <.link navigate={~p"/portfolio"} class="btn btn-outline gap-[var(--space-xs)]">
          <.icon name="hero-squares-2x2" class="h-5 w-5" /> {gettext("View Portfolio")}
        </.link>
        <.link navigate={~p"/users/settings"} class="btn btn-outline gap-[var(--space-xs)]">
          <.icon name="hero-cog-6-tooth" class="h-5 w-5" /> {gettext("Settings")}
        </.link>
      </div>
    </section>
    
<!-- Recent Posts -->
    <section class="mb-[var(--spacing-section)]">
      <div class="mb-[var(--spacing-md)] flex items-center justify-between">
        <h2 class="text-[var(--font-size-fluid-xl)] font-semibold">
          {gettext("Recent Posts")}
        </h2>
        <.link navigate={~p"/posts"} class="link link-primary">
          {gettext("View all")} →
        </.link>
      </div>

      <div :if={@post_count == 0} class="alert alert-info">
        <.icon name="hero-information-circle" class="h-6 w-6" />
        <span>
          {gettext("You haven't created any posts yet.")} <.link
            navigate={~p"/posts/new"}
            class="link"
          >{gettext("Create your first post")}</.link>!
        </span>
      </div>

      <div :if={@post_count > 0} class="overflow-x-auto">
        <table class="table-zebra table">
          <thead>
            <tr>
              <th>{gettext("Title")}</th>
              <th>{gettext("Published")}</th>
              <th>{gettext("Actions")}</th>
            </tr>
          </thead>
          <tbody>
            <%= for post <- Enum.take(@posts, 5) do %>
              <tr>
                <td>
                  <.link navigate={~p"/posts/#{post}"} class="link link-hover font-medium">
                    {post.title}
                  </.link>
                </td>
                <td>
                  <%= if post.published_at do %>
                    {format_date(post.published_at)}
                  <% else %>
                    <span class="badge badge-ghost">{gettext("Draft")}</span>
                  <% end %>
                </td>
                <td>
                  <div class="gap-[var(--space-xs)] flex">
                    <.link navigate={~p"/posts/#{post}"} class="btn btn-ghost btn-xs">
                      {gettext("View")}
                    </.link>
                    <.link navigate={~p"/posts/#{post}/edit"} class="btn btn-ghost btn-xs">
                      {gettext("Edit")}
                    </.link>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

    <%!-- Recent Projects --%>
    <section class="mb-[var(--spacing-section)]">
      <div class="mb-[var(--spacing-md)] flex items-center justify-between">
        <h2 class="text-[var(--font-size-fluid-xl)] font-semibold">
          {gettext("Recent Projects")}
        </h2>
        <.link navigate={~p"/projects"} class="link link-primary">
          {gettext("View all")} →
        </.link>
      </div>

      <div :if={@media_stats.projects.total == 0} class="alert alert-info">
        <.icon name="hero-information-circle" class="h-6 w-6" />
        <span>
          {gettext("You haven't created any projects yet.")} <.link
            navigate={~p"/projects/new"}
            class="link"
          >{gettext("Create your first project")}</.link>!
        </span>
      </div>

      <div :if={@media_stats.projects.total > 0} class="overflow-x-auto">
        <table class="table-zebra table">
          <thead>
            <tr>
              <th>{gettext("Name")}</th>
              <th>{gettext("Type")}</th>
              <th>{gettext("Visibility")}</th>
              <th>{gettext("Completion")}</th>
              <th>{gettext("Actions")}</th>
            </tr>
          </thead>
          <tbody>
            <%= for project <- @recent_projects do %>
              <tr>
                <td>
                  <.link navigate={~p"/projects/#{project}"} class="link link-hover font-medium">
                    {project.name}
                  </.link>
                </td>
                <td>
                  <%= if project.is_portfolio do %>
                    <span class="badge badge-primary badge-sm">{gettext("Portfolio")}</span>
                  <% else %>
                    <span class="badge badge-ghost badge-sm">{gettext("Library")}</span>
                  <% end %>
                </td>
                <td>
                  <%= if project.is_public do %>
                    <span class="badge badge-success badge-sm">{gettext("Public")}</span>
                  <% else %>
                    <span class="badge badge-warning badge-sm">{gettext("Private")}</span>
                  <% end %>
                </td>
                <td>
                  <div class="gap-[var(--space-xs)] flex items-center">
                    <progress
                      class="progress progress-primary w-16"
                      value={project.completion_percentage}
                      max="100"
                    >
                    </progress>
                    <span class="text-[var(--text-xs)]">{project.completion_percentage}%</span>
                  </div>
                </td>
                <td>
                  <div class="gap-[var(--space-xs)] flex">
                    <.link navigate={~p"/projects/#{project}"} class="btn btn-ghost btn-xs">
                      {gettext("View")}
                    </.link>
                    <.link navigate={~p"/projects/#{project}/edit"} class="btn btn-ghost btn-xs">
                      {gettext("Edit")}
                    </.link>
                    <%= if project.is_public && project.is_portfolio do %>
                      <.link
                        navigate={~p"/portfolio/#{project.slug}"}
                        class="btn btn-ghost btn-xs"
                      >
                        <.icon name="hero-globe-alt" class="h-3 w-3" />
                      </.link>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
    
<!-- Feed Sources -->
    <section class="mb-[var(--spacing-section)]">
      <div class="mb-[var(--spacing-md)] flex items-center justify-between">
        <h2 class="text-[var(--font-size-fluid-xl)] font-semibold">
          {gettext("Your Feed Sources")}
        </h2>
        <.link navigate={~p"/feeds"} class="link link-primary">
          {gettext("View all")} →
        </.link>
      </div>

      <div :if={@feed_count == 0} class="alert alert-info">
        <.icon name="hero-information-circle" class="h-6 w-6" />
        <span>
          {gettext("You haven't added any feed sources yet.")} <.link
            navigate={~p"/feeds/new"}
            class="link"
          >{gettext("Add your first feed source")}</.link>!
        </span>
      </div>

      <div :if={@feed_count > 0} class="overflow-x-auto">
        <table class="table-zebra table">
          <thead>
            <tr>
              <th>{gettext("Name")}</th>
              <th>{gettext("Type")}</th>
              <th>{gettext("Status")}</th>
              <th>{gettext("Last Updated")}</th>
              <th>{gettext("Actions")}</th>
            </tr>
          </thead>
          <tbody>
            <%= for feed <- Enum.take(@feed_sources, 5) do %>
              <tr>
                <td>
                  <div class="gap-[var(--space-xs)] flex items-center">
                    <span class="text-[var(--text-2xl)]">{feed.icon}</span>
                    <.link navigate={~p"/feeds/#{feed}"} class="link link-hover font-medium">
                      {feed.name}
                    </.link>
                  </div>
                </td>
                <td>
                  <span class="badge badge-outline">{feed.feed_type}</span>
                </td>
                <td>
                  <%= if feed.enabled do %>
                    <span class="badge badge-success">{gettext("Enabled")}</span>
                  <% else %>
                    <span class="badge badge-ghost">{gettext("Disabled")}</span>
                  <% end %>
                  <%= if feed.last_error do %>
                    <span class="badge badge-error">{gettext("Error")}</span>
                  <% end %>
                </td>
                <td>
                  <%= if feed.last_fetched_at do %>
                    {format_date(feed.last_fetched_at)}
                  <% else %>
                    <span class="text-gray-400">{gettext("Never")}</span>
                  <% end %>
                </td>
                <td>
                  <div class="gap-[var(--space-xs)] flex">
                    <.link navigate={~p"/feeds/#{feed}"} class="btn btn-ghost btn-xs">
                      {gettext("View")}
                    </.link>
                    <.link navigate={~p"/feeds/#{feed}/edit"} class="btn btn-ghost btn-xs">
                      {gettext("Edit")}
                    </.link>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
    
<!-- Recent Tags -->
    <section>
      <div class="mb-[var(--spacing-md)] flex items-center justify-between">
        <h2 class="text-[var(--font-size-fluid-xl)] font-semibold">
          {gettext("Your Tags")}
        </h2>
        <.link navigate={~p"/tags"} class="link link-primary">
          {gettext("View all")} →
        </.link>
      </div>

      <div :if={@tag_count == 0} class="alert alert-info">
        <.icon name="hero-information-circle" class="h-6 w-6" />
        <span>
          {gettext("You haven't created any tags yet.")} <.link
            navigate={~p"/tags/new"}
            class="link"
          >{gettext("Create your first tag")}</.link>!
        </span>
      </div>

      <div :if={@tag_count > 0} class="gap-[var(--space-xs)] flex flex-wrap">
        <%= for tag <- Enum.take(@tags, 10) do %>
          <.link
            navigate={~p"/tags/#{tag}"}
            class="badge badge-lg badge-primary px-[var(--space-sm)] py-[var(--space-xs)]"
          >
            {tag.name}
          </.link>
        <% end %>
      </div>
    </section>
  </div>
</Layouts.app>
