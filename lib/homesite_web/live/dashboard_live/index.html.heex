<Layouts.app flash={@flash} current_scope={@current_scope}>
  <main class="px-[var(--spacing-card)] py-[var(--spacing-lg)] container mx-auto">
    <!-- Header -->
    <header class="gap-[var(--spacing-md)] mb-[var(--spacing-section)] flex flex-col">
      <h1 class="text-[var(--font-size-fluid-2xl)] font-bold">
        {gettext("Welcome back")}, {@current_scope.user.display_name ||
          String.split(@current_scope.user.email, "@") |> List.first()}!
      </h1>

      <div class="gap-[var(--spacing-md)] flex flex-wrap">
        <!-- Stats Cards -->
        <div class="stats bg-base-200 shadow">
          <div class="stat">
            <div class="stat-title">{gettext("Total Posts")}</div>
            <div class="stat-value text-primary">{@post_count}</div>
            <div class="stat-desc">
              {gettext("%{published} published, %{draft} drafts",
                published: @published_count,
                draft: @draft_count
              )}
            </div>
            <div class="stat-actions">
              <.link navigate={~p"/posts"} class="btn btn-sm btn-primary">
                {gettext("View all")}
              </.link>
            </div>
          </div>
        </div>

        <div class="stats bg-base-200 shadow">
          <div class="stat">
            <div class="stat-title">{gettext("Total Tags")}</div>
            <div class="stat-value text-secondary">{@tag_count}</div>
            <div class="stat-actions">
              <.link navigate={~p"/tags"} class="btn btn-sm btn-secondary">
                {gettext("View all")}
              </.link>
            </div>
          </div>
        </div>
      </div>
    </header>

    <%!-- Recent Activities --%>
    <%= if length(@activities) > 0 do %>
      <section class="mb-[var(--spacing-section)]">
        <h2 class="text-[var(--font-size-fluid-xl)] mb-[var(--spacing-md)] font-semibold">
          {gettext("Recent Activity")}
        </h2>
        <div class="space-y-2">
          <%= for activity <- @activities do %>
            <div class="alert bg-base-200 shadow-sm">
              <div>
                <div class="flex items-center gap-2">
                  <%= if activity.activity_type == "blog_published" do %>
                    <.icon name="hero-document-check" class="text-success h-5 w-5" />
                  <% else %>
                    <.icon name="hero-document-text" class="text-info h-5 w-5" />
                  <% end %>
                  <span class="font-medium">{activity.content}</span>
                </div>
                <div class="text-base-content/60 mt-1 text-sm">
                  {Calendar.strftime(activity.inserted_at, "%B %d, %Y at %H:%M")}
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>
    
<!-- Quick Actions -->
    <section class="mb-[var(--spacing-section)]">
      <h2 class="text-[var(--font-size-fluid-xl)] mb-[var(--spacing-md)] font-semibold">
        {gettext("Quick Actions")}
      </h2>
      <div class="gap-[var(--spacing-sm)] flex flex-wrap">
        <.link navigate={~p"/posts/new"} class="btn btn-primary gap-2">
          <.icon name="hero-plus" class="h-5 w-5" /> {gettext("New Post")}
        </.link>
        <.link navigate={~p"/tags/new"} class="btn btn-secondary gap-2">
          <.icon name="hero-plus" class="h-5 w-5" /> {gettext("New Tag")}
        </.link>
        <.link navigate={~p"/users/settings"} class="btn btn-outline gap-2">
          <.icon name="hero-cog-6-tooth" class="h-5 w-5" /> {gettext("Settings")}
        </.link>
      </div>
    </section>
    
<!-- Recent Posts -->
    <section class="mb-[var(--spacing-section)]">
      <div class="mb-[var(--spacing-md)] flex items-center justify-between">
        <h2 class="text-[var(--font-size-fluid-xl)] font-semibold">
          {gettext("Recent Posts")}
        </h2>
        <.link navigate={~p"/posts"} class="link link-primary">
          {gettext("View all")} →
        </.link>
      </div>

      <div :if={@post_count == 0} class="alert alert-info">
        <.icon name="hero-information-circle" class="h-6 w-6" />
        <span>
          {gettext("You haven't created any posts yet.")} <.link
            navigate={~p"/posts/new"}
            class="link"
          >{gettext("Create your first post")}</.link>!
        </span>
      </div>

      <div :if={@post_count > 0} class="overflow-x-auto">
        <table class="table-zebra table">
          <thead>
            <tr>
              <th>{gettext("Title")}</th>
              <th>{gettext("Published")}</th>
              <th>{gettext("Actions")}</th>
            </tr>
          </thead>
          <tbody>
            <%= for post <- Enum.take(@posts, 5) do %>
              <tr>
                <td>
                  <.link navigate={~p"/posts/#{post}"} class="link link-hover font-medium">
                    {post.title}
                  </.link>
                </td>
                <td>
                  <%= if post.published_at do %>
                    {Calendar.strftime(post.published_at, "%B %d, %Y")}
                  <% else %>
                    <span class="badge badge-ghost">{gettext("Draft")}</span>
                  <% end %>
                </td>
                <td>
                  <div class="flex gap-2">
                    <.link navigate={~p"/posts/#{post}"} class="btn btn-ghost btn-xs">
                      {gettext("View")}
                    </.link>
                    <.link navigate={~p"/posts/#{post}/edit"} class="btn btn-ghost btn-xs">
                      {gettext("Edit")}
                    </.link>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
    
<!-- Recent Tags -->
    <section>
      <div class="mb-[var(--spacing-md)] flex items-center justify-between">
        <h2 class="text-[var(--font-size-fluid-xl)] font-semibold">
          {gettext("Your Tags")}
        </h2>
        <.link navigate={~p"/tags"} class="link link-primary">
          {gettext("View all")} →
        </.link>
      </div>

      <div :if={@tag_count == 0} class="alert alert-info">
        <.icon name="hero-information-circle" class="h-6 w-6" />
        <span>
          {gettext("You haven't created any tags yet.")} <.link
            navigate={~p"/tags/new"}
            class="link"
          >{gettext("Create your first tag")}</.link>!
        </span>
      </div>

      <div :if={@tag_count > 0} class="flex flex-wrap gap-2">
        <%= for tag <- Enum.take(@tags, 10) do %>
          <.link navigate={~p"/tags/#{tag}"} class="badge badge-lg badge-primary px-4 py-3">
            {tag.name}
          </.link>
        <% end %>
      </div>
    </section>
  </main>
</Layouts.app>
