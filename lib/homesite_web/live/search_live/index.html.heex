<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="mt-[var(--space-md)]">
    <.page_header>
      <div class="gap-[var(--space-sm)] flex items-center justify-center">
        <.icon name="hero-magnifying-glass" class="h-8 w-8" />
        <span>{gettext("Search")}</span>
      </div>
    </.page_header>

    <div class="mt-[var(--space-md)]">
      <form id="search-form" phx-submit="search" class="mb-[var(--space-md)] mx-auto max-w-3xl">
        <div class="gap-[var(--space-xs)] flex">
          <input
            type="text"
            name="query"
            value={@query}
            placeholder={gettext("Search by title or content...")}
            phx-debounce="300"
            autocomplete="off"
            aria-label={gettext("Search query")}
            class="input input-bordered flex-1"
          />
          <button type="submit" class="btn btn-primary">
            <.icon name="hero-magnifying-glass" class="h-5 w-5" />
            {gettext("Search")}
          </button>
          <%= if @query != "" do %>
            <button
              type="button"
              phx-click="clear"
              class="btn btn-ghost"
              aria-label={gettext("Clear search")}
            >
              <.icon name="hero-x-mark" class="h-5 w-5" />
            </button>
          <% end %>
        </div>
      </form>

      <%= if @searching and @query != "" do %>
        <div
          class="text-base-content/70 mb-[var(--space-sm)] text-[var(--text-sm)]"
          aria-live="polite"
          aria-atomic="true"
        >
          <%= if @total_count == 0 do %>
            <div class="alert alert-info" role="status">
              <.icon name="hero-information-circle" class="h-5 w-5" />
              <span>{gettext("No results found for")} "{@query}"</span>
            </div>
          <% else %>
            <p role="status">
              {ngettext("1 result found", "%{count} results found", @total_count)}
              {gettext("for")} "{@query}"
            </p>
          <% end %>
        </div>
      <% end %>

      <%= if @searching and @total_count > 0 do %>
        <div class="space-y-[var(--space-sm)]">
          <%!-- Tags Section (first) --%>
          <%= if not Enum.empty?(@tags) do %>
            <section class="card bg-base-100 shadow-sm">
              <div class="card-body p-[var(--space-sm)]">
                <h2 class="gap-[var(--space-xs)] text-[var(--text-lg)] flex items-center font-semibold">
                  <.icon name="hero-tag" class="text-secondary h-5 w-5" />
                  {gettext("Tags")}
                  <span class="badge badge-secondary badge-sm">{length(@tags)}</span>
                </h2>
                <div class="mt-[var(--space-xs)] flex flex-wrap gap-1">
                  <%= for tag <- @tags do %>
                    <.link
                      navigate={~p"/tags/#{tag.slug}"}
                      class="badge badge-secondary gap-1 transition-colors hover:badge-primary"
                    >
                      {tag.name}
                    </.link>
                  <% end %>
                </div>
              </div>
            </section>
          <% end %>
          <%!-- Posts Section --%>
          <%= if not Enum.empty?(@posts) do %>
            <section class="card bg-base-100 shadow-sm">
              <div class="card-body p-[var(--space-sm)]">
                <h2 class="gap-[var(--space-xs)] text-[var(--text-lg)] flex items-center font-semibold">
                  <.icon name="hero-document-text" class="text-primary h-5 w-5" />
                  {gettext("Posts")}
                  <span class="badge badge-primary badge-sm">{length(@posts)}</span>
                </h2>
                <div class="divide-base-200 mt-[var(--space-xs)] divide-y">
                  <%= for post <- @posts do %>
                    <article class="py-[var(--space-xs)] rounded transition-colors hover:bg-base-200/50">
                      <div class="gap-[var(--space-sm)] flex items-start justify-between">
                        <div class="min-w-0 flex-1">
                          <h3 class="text-[var(--text-base)] font-medium">
                            <.link
                              navigate={~p"/posts/#{post.slug}"}
                              class="link link-hover"
                            >
                              {post.title}
                            </.link>
                          </h3>
                          <div class="text-base-content/60 gap-[var(--space-xs)] text-[var(--text-xs)] mt-0.5 flex flex-wrap items-center">
                            <span>{post.user.email}</span>
                            <%= if post.published_at do %>
                              <span>•</span>
                              <time datetime={post.published_at}>
                                {format_date(post.published_at)}
                              </time>
                            <% end %>
                            <%= if not Enum.empty?(post.tags) do %>
                              <span>•</span>
                              <%= for tag <- Enum.take(post.tags, 3) do %>
                                <.link
                                  navigate={~p"/tags/#{tag.slug}"}
                                  class="badge badge-primary badge-xs"
                                >
                                  {tag.name}
                                </.link>
                              <% end %>
                              <%= if length(post.tags) > 3 do %>
                                <span class="text-base-content/40">+{length(post.tags) - 3}</span>
                              <% end %>
                            <% end %>
                          </div>
                        </div>
                        <.link
                          navigate={~p"/posts/#{post.slug}"}
                          class="btn btn-ghost btn-xs flex-shrink-0"
                        >
                          <.icon name="hero-arrow-right" class="h-4 w-4" />
                        </.link>
                      </div>
                    </article>
                  <% end %>
                </div>
              </div>
            </section>
          <% end %>
          <%!-- FAQs Section --%>
          <%= if not Enum.empty?(@faqs) do %>
            <section class="card bg-base-100 shadow-sm">
              <div class="card-body p-[var(--space-sm)]">
                <h2 class="gap-[var(--space-xs)] text-[var(--text-lg)] flex items-center font-semibold">
                  <.icon name="hero-question-mark-circle" class="text-accent h-5 w-5" />
                  {gettext("FAQs")}
                  <span class="badge badge-accent badge-sm">{length(@faqs)}</span>
                </h2>
                <div class="divide-base-200 mt-[var(--space-xs)] divide-y">
                  <%= for faq <- @faqs do %>
                    <div class="py-[var(--space-xs)] rounded transition-colors hover:bg-base-200/50">
                      <div class="gap-[var(--space-sm)] flex items-start justify-between">
                        <div class="min-w-0 flex-1">
                          <h3 class="text-[var(--text-base)] font-medium">
                            {faq.question}
                          </h3>
                          <p class="text-base-content/60 line-clamp-1 text-[var(--text-sm)] mt-0.5">
                            {raw(truncate_html(faq.answer, 100))}
                          </p>
                        </div>
                        <span class="badge badge-ghost badge-xs flex-shrink-0">
                          {String.upcase(faq.category)}
                        </span>
                      </div>
                    </div>
                  <% end %>
                </div>
                <div class="mt-[var(--space-xs)]">
                  <.link navigate={~p"/faqs"} class="btn btn-ghost btn-xs">
                    {gettext("View all FAQs")} →
                  </.link>
                </div>
              </div>
            </section>
          <% end %>
        </div>
      <% else %>
        <%= if @query == "" do %>
          <div class="py-[var(--space-lg)] text-center">
            <.icon name="hero-magnifying-glass" class="text-base-content/40 mx-auto h-12 w-12" />
            <h2 class="text-base-content mt-[var(--space-xs)] text-[var(--text-sm)] font-semibold">
              {gettext("Start searching")}
            </h2>
            <p class="text-base-content/60 mt-[var(--space-xs)] text-[var(--text-sm)]">
              {gettext("Enter keywords to search through blog posts")}
            </p>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</Layouts.app>
