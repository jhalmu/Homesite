<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="px-[clamp(1rem,4vw,2rem)] py-[clamp(1.5rem,5vw,3rem)] container mx-auto">
    <!-- Hero Section -->
    <div class="hero min-h-[clamp(20rem,40vh,30rem)] bg-base-200 rounded-box mb-[clamp(2rem,5vw,3rem)]">
      <div class="hero-content text-center">
        <div class="max-w-md">
          <h1 class="text-[clamp(2.5rem,7vw,4rem)] font-bold">
            Welcome to Homesite
          </h1>
          <p class="text-[clamp(1rem,3vw,1.25rem)] py-6">
            A personal blogging platform for sharing ideas and stories.
          </p>
          <%= if @current_scope do %>
            <.link navigate={~p"/dashboard"} class="btn btn-primary btn-lg gap-2">
              <.icon name="hero-home" class="h-6 w-6" /> Go to Dashboard
            </.link>
          <% end %>
        </div>
      </div>
    </div>
    
<!-- Recent Posts -->
    <div>
      <h2 class="text-[clamp(1.75rem,5vw,2.5rem)] mb-[clamp(1.5rem,4vw,2rem)] font-bold">
        Recent Posts
      </h2>

      <div :if={length(@posts) == 0} class="alert alert-info">
        <.icon name="hero-information-circle" class="h-6 w-6" />
        <span>No published posts yet. Be the first to share something!</span>
      </div>

      <div
        :if={length(@posts) > 0}
        class="gap-[clamp(1rem,3vw,2rem)] grid w-full"
        style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 350px), 1fr));"
      >
        <%= for post <- @posts do %>
          <.link navigate={~p"/posts/#{post.id}"} class="group">
            <article class="card bg-base-200 h-full shadow-lg transition-all hover:-translate-y-1 hover:shadow-xl">
              <div class="card-body">
                <h3 class="card-title text-[clamp(1.25rem,3vw,1.5rem)] transition-colors group-hover:text-primary">
                  {post.title}
                </h3>

                <.author_byline user={post.user} date={post.published_at} class="mb-3" />

                <p :if={post.body} class="line-clamp-3 text-sm opacity-80">
                  {String.slice(post.body, 0, 200)}{if String.length(post.body) > 200, do: "..."}
                </p>

                <div class="card-actions mt-4 items-center justify-between">
                  <.link
                    navigate={~p"/users/#{post.user.id}"}
                    class="btn btn-sm btn-ghost gap-2"
                    onclick="event.stopPropagation()"
                  >
                    <.avatar user={post.user} class="h-6 w-6" /> {post.user.display_name ||
                      String.slice(post.user.email, 0, 10)}
                  </.link>
                  <span class="text-primary text-sm opacity-0 transition-opacity group-hover:opacity-100">
                    Read more →
                  </span>
                </div>
              </div>
            </article>
          </.link>
        <% end %>
      </div>
    </div>
  </div>
</Layouts.app>
