<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="technical-main">
    <h1 class="sr-only">{gettext("Portal of JH - Blog Homepage")}</h1>
    <div>
      <div :if={length(@posts) == 0} class="alert alert-info mx-auto max-w-4xl">
        <.icon name="hero-information-circle" class="h-6 w-6" />
        <span>{gettext("No published posts yet. Be the first to share something!")}</span>
      </div>

      <%= if length(@posts) > 0 do %>
        <% [latest_post | rest_posts] = @posts %>
        <% {next_three, older_posts} = Enum.split(rest_posts, 3) %>
        
<!-- Latest Post (Featured) -->
        <article class="post-card">
          <div class="post-meta mb-4">
            <time datetime={latest_post.published_at}>
              {Calendar.strftime(latest_post.published_at, "%Y-%m-%d")}
            </time>
            <span>•</span>
            <%= if latest_post.tags && length(latest_post.tags) > 0 do %>
              <%= for tag <- Enum.take(latest_post.tags, 2) do %>
                <span class="tag-technical">{tag.name}</span>
              <% end %>
            <% end %>
          </div>

          <.link navigate={~p"/posts/#{latest_post.id}"} class="group">
            <h2 class="post-title transition-colors group-hover:text-primary">
              {latest_post.title}
            </h2>
          </.link>

          <p :if={latest_post.body} class="post-excerpt">
            {markdown_preview(latest_post.body, 200)}
          </p>

          <div class="post-footer">
            <span>{latest_post.read_time_minutes} min {gettext("read time")}</span>
            <span>•</span>
            <span>{latest_post.user.display_name || latest_post.user.email}</span>
          </div>
        </article>
        
<!-- Next 3 Posts in Grid -->
        <div :if={length(next_three) > 0} class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-3">
          <%= for post <- next_three do %>
            <article class="post-card">
              <div class="post-meta mb-3">
                <time datetime={post.published_at}>
                  {Calendar.strftime(post.published_at, "%Y-%m-%d")}
                </time>
              </div>

              <.link navigate={~p"/posts/#{post.id}"} class="group">
                <h3 class="post-title text-lg transition-colors group-hover:text-primary">
                  {post.title}
                </h3>
              </.link>

              <p :if={post.body} class="post-excerpt text-sm">
                {markdown_preview(post.body, 100)}
              </p>

              <div class="post-footer text-xs">
                <span>{post.read_time_minutes} min</span>
              </div>
            </article>
          <% end %>
        </div>
        
<!-- Older Posts (List View) -->
        <div :if={length(older_posts) > 0} class="mt-12 space-y-6">
          <div class="space-y-6">
            <%= for post <- older_posts do %>
              <article class="post-card">
                <div class="post-meta mb-4">
                  <time datetime={post.published_at}>
                    {Calendar.strftime(post.published_at, "%Y-%m-%d")}
                  </time>
                  <span>•</span>
                  <%= if post.tags && length(post.tags) > 0 do %>
                    <%= for tag <- Enum.take(post.tags, 2) do %>
                      <span class="tag-technical">{tag.name}</span>
                    <% end %>
                  <% end %>
                </div>

                <.link navigate={~p"/posts/#{post.id}"} class="group">
                  <h2 class="post-title transition-colors group-hover:text-primary">
                    {post.title}
                  </h2>
                </.link>

                <p :if={post.body} class="post-excerpt">
                  {markdown_preview(post.body, 200)}
                </p>

                <div class="post-footer">
                  <span>{post.read_time_minutes} min {gettext("read time")}</span>
                  <span>•</span>
                  <span>{post.user.display_name || post.user.email}</span>
                </div>
              </article>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</Layouts.app>
