<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="technical-main">
    <h1 class="sr-only">{gettext("Portal of JH - Blog Homepage")}</h1>
    <div class="hero-section">
      <div
        :if={length(@posts) == 0}
        class="alert alert-info max-w-[var(--article-max-width)] mx-auto"
      >
        <.icon name="hero-information-circle" class="h-6 w-6" />
        <span>{gettext("No published posts yet. Be the first to share something!")}</span>
      </div>

      <%= if length(@posts) > 0 do %>
        <% [latest_post | rest_posts] = @posts %>
        <% {next_three, older_posts} = Enum.split(rest_posts, 3) %>
        
<!-- Latest Post (Featured) -->
        <article class="post-card">
          <div class="post-meta mb-[var(--spacing-md)]">
            <time datetime={latest_post.published_at}>
              {format_date(latest_post.published_at)}
            </time>
            <span>•</span>
            <%= if latest_post.tags && length(latest_post.tags) > 0 do %>
              <%= for tag <- Enum.take(latest_post.tags, 2) do %>
                <span class="tag-technical">{tag.name}</span>
              <% end %>
            <% end %>
          </div>

          <.link navigate={~p"/posts/#{latest_post.id}"} class="group">
            <h2 class="post-title duration-[var(--duration-normal)] transition-colors group-hover:text-primary">
              {latest_post.title}
            </h2>
          </.link>

          <p :if={latest_post.body} class="post-excerpt">
            {markdown_preview(latest_post.body, 300)}
          </p>

          <div class="post-footer">
            <span>{latest_post.read_time_minutes} min {gettext("read time")}</span>
            <span>•</span>
            <span>{latest_post.user.display_name || latest_post.user.email}</span>
          </div>
        </article>
        
<!-- Next 3 Posts in Grid -->
        <div
          :if={length(next_three) > 0}
          class="mt-[var(--spacing-md)] gap-[var(--spacing-md)] grid grid-cols-1 md:grid-cols-3"
        >
          <%= for post <- next_three do %>
            <article class="post-card">
              <div class="post-meta mb-[var(--spacing-sm)]">
                <time datetime={post.published_at}>
                  {format_date(post.published_at)}
                </time>
              </div>

              <.link navigate={~p"/posts/#{post.id}"} class="group">
                <h3 class="post-title text-[var(--font-size-fluid-lg)] duration-[var(--duration-normal)] transition-colors group-hover:text-primary">
                  {post.title}
                </h3>
              </.link>

              <p :if={post.body} class="post-excerpt text-[var(--text-sm)]">
                {markdown_preview(post.body, 150)}
              </p>

              <div class="post-footer text-[var(--text-xs)]">
                <span>{post.read_time_minutes} min</span>
              </div>
            </article>
          <% end %>
        </div>
        
<!-- Older Posts (List View) -->
        <div
          :if={length(older_posts) > 0}
          class="mt-[var(--spacing-section)] space-y-[var(--spacing-md)]"
        >
          <div class="space-y-[var(--spacing-md)]">
            <%= for post <- older_posts do %>
              <article class="post-card">
                <div class="post-meta mb-[var(--spacing-md)]">
                  <time datetime={post.published_at}>
                    {format_date(post.published_at)}
                  </time>
                  <span>•</span>
                  <%= if post.tags && length(post.tags) > 0 do %>
                    <%= for tag <- Enum.take(post.tags, 2) do %>
                      <span class="tag-technical">{tag.name}</span>
                    <% end %>
                  <% end %>
                </div>

                <.link navigate={~p"/posts/#{post.id}"} class="group">
                  <h3 class="post-title duration-[var(--duration-normal)] transition-colors group-hover:text-primary">
                    {post.title}
                  </h3>
                </.link>

                <p :if={post.body} class="post-excerpt">
                  {markdown_preview(post.body, 200)}
                </p>

                <div class="post-footer">
                  <span>{post.read_time_minutes} min {gettext("read time")}</span>
                  <span>•</span>
                  <span>{post.user.display_name || post.user.email}</span>
                </div>

                <%!-- Share buttons --%>
                <%= if post.read_time_minutes >= 2 do %>
                  <div class="border-base-300 mt-[var(--spacing-md)] pt-[var(--spacing-md)] border-t">
                    <.platform_share_buttons url={post.absolute_url} title={post.title} />
                  </div>
                <% end %>
              </article>
            <% end %>
          </div>
        </div>

        <%!-- Load More Button --%>
        <%= if @has_more_posts do %>
          <div class="mt-[var(--spacing-lg)] text-center">
            <button phx-click="load_more_posts" class="btn btn-outline btn-wide">
              {gettext("Load More Posts")}
            </button>
          </div>
        <% end %>
      <% end %>

      <%!-- Public Projects Showcase --%>
      <%= if length(@public_projects) > 0 do %>
        <div class="mt-[var(--spacing-section)] space-y-[var(--spacing-md)]">
          <div class="flex items-center justify-between">
            <h2 class="text-[var(--font-size-fluid-xl)] font-bold">
              <.icon name="hero-folder" class="inline h-6 w-6" />
              {gettext("Featured Projects")}
            </h2>
            <.link navigate={~p"/portfolio"} class="btn btn-sm btn-ghost">
              {gettext("View all projects")} →
            </.link>
          </div>

          <div class="gap-[var(--spacing-md)] grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
            <%= for project <- @public_projects do %>
              <article class="card bg-base-200 duration-[var(--duration-normal)] border-base-300 border shadow-lg transition-shadow hover:shadow-xl">
                <div class="card-body p-[var(--spacing-card)]">
                  <%!-- Project type badge --%>
                  <div class="mb-[var(--spacing-sm)] gap-[var(--spacing-inline)] flex items-center">
                    <span class="badge badge-primary badge-sm">{project.template_type}</span>
                    <%= if project.is_portfolio do %>
                      <span class="badge badge-secondary badge-sm">{gettext("Portfolio")}</span>
                    <% end %>
                  </div>

                  <%!-- Project title --%>
                  <.link navigate={~p"/portfolio/#{project.slug}"} class="group">
                    <h3 class="mb-[var(--spacing-sm)] text-[var(--font-size-fluid-lg)] line-clamp-2 duration-[var(--duration-normal)] font-semibold transition-colors group-hover:text-primary">
                      {project.name}
                    </h3>
                  </.link>

                  <%!-- Project description --%>
                  <p
                    :if={project.description}
                    class="text-[var(--text-sm)] line-clamp-2 opacity-70"
                  >
                    {project.description}
                  </p>

                  <%!-- Project metadata --%>
                  <div class="text-[var(--text-xs)] gap-[var(--spacing-inline)] pt-[var(--spacing-sm)] mt-auto flex items-center opacity-70">
                    <%= if project.category do %>
                      <span>{project.category}</span>
                    <% end %>
                    <%= if project.user do %>
                      <span>•</span>
                      <span>{project.user.display_name || project.user.email}</span>
                    <% end %>
                  </div>

                  <%!-- Completion indicator --%>
                  <div class="mt-[var(--spacing-sm)]">
                    <div class="text-[var(--text-xs)] mb-1 flex justify-between opacity-60">
                      <span>{gettext("Completion")}</span>
                      <span>{project.completion_percentage}%</span>
                    </div>
                    <progress
                      class="progress progress-primary w-full"
                      value={project.completion_percentage}
                      max="100"
                    >
                    </progress>
                  </div>
                </div>
              </article>
            <% end %>
          </div>
        </div>
      <% end %>

      <%!-- External Feeds Section --%>
      <%= if @current_scope && length(@feed_items) > 0 do %>
        <div class="mt-[var(--spacing-section)] space-y-[var(--spacing-md)]">
          <div class="flex items-center justify-between">
            <h2 class="text-[var(--font-size-fluid-xl)] font-bold">
              {gettext("Recent from Feeds")}
            </h2>
            <.link navigate={~p"/feeds"} class="btn btn-sm btn-ghost">
              {gettext("View all feeds")} →
            </.link>
          </div>

          <div class="gap-[var(--spacing-md)] grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
            <%= for item <- @feed_items do %>
              <article class="card bg-base-200 duration-[var(--duration-normal)] border-base-300 border shadow-lg transition-shadow hover:shadow-xl">
                <div class="card-body p-[var(--spacing-card)]">
                  <%!-- Feed source badge --%>
                  <div class="mb-[var(--spacing-sm)] gap-[var(--spacing-inline)] flex items-center">
                    <span class="text-[var(--font-size-fluid-lg)]">{item.feed_source.icon}</span>
                    <span class="badge badge-sm badge-ghost">{item.feed_source.name}</span>
                  </div>

                  <%!-- Item title --%>
                  <h3 class="mb-[var(--spacing-sm)] text-[var(--font-size-fluid-lg)] line-clamp-2 font-semibold">
                    <%= if item.url do %>
                      <a
                        href={item.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="duration-[var(--duration-normal)] transition-colors hover:text-primary"
                      >
                        {item.title}
                      </a>
                    <% else %>
                      {item.title}
                    <% end %>
                  </h3>

                  <%!-- Item metadata --%>
                  <div class="text-[var(--text-xs)] gap-[var(--spacing-inline)] flex items-center opacity-70">
                    <%= if item.published_at do %>
                      <time datetime={item.published_at}>
                        {format_date(item.published_at)}
                      </time>
                    <% end %>
                    <%= if item.author_name do %>
                      <span>•</span>
                      <span>{item.author_name}</span>
                    <% end %>
                  </div>

                  <%!-- External link indicator --%>
                  <%= if item.url do %>
                    <div class="mt-[var(--spacing-sm)] pt-[var(--spacing-sm)] border-base-300 border-t">
                      <a
                        href={item.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-xs btn-ghost gap-[var(--spacing-inline)]"
                      >
                        <.icon name="hero-arrow-top-right-on-square" class="h-3 w-3" />
                        {gettext("Read more")}
                      </a>
                    </div>
                  <% end %>
                </div>
              </article>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</Layouts.app>
