<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="technical-main">
    <.header>
      <div class="gap-[var(--space-sm)] flex items-center">
        <span class="text-4xl">{@feed_source.icon}</span>
        <div>
          {@feed_source.name}
          <.badge color={if @feed_source.enabled, do: :green, else: :gray}>
            {if @feed_source.enabled, do: "Enabled", else: "Disabled"}
          </.badge>
        </div>
      </div>
      <:subtitle>
        {@feed_source.feed_type}
        <%= if @feed_source.url do %>
          ·
          <a href={@feed_source.url} target="_blank" class="text-blue-600 hover:underline">
            {@feed_source.url}
          </a>
        <% end %>
        <%= if @feed_source.username do %>
          · @{@feed_source.username}
        <% end %>
      </:subtitle>
      <:actions>
        <.link navigate={~p"/feeds"}>
          <.button>
            <.icon name="hero-arrow-left" class="h-4 w-4" /> Back to Feeds
          </.button>
        </.link>
        <.link
          phx-click="toggle_enabled"
          class="text-[var(--text-sm)] font-semibold"
        >
          <.button>
            {if @feed_source.enabled, do: "Disable", else: "Enable"}
          </.button>
        </.link>
        <.link
          phx-click="refresh_now"
          class="text-[var(--text-sm)] font-semibold"
        >
          <.button>
            <.icon name="hero-arrow-path" class="h-4 w-4" /> Refresh Now
          </.button>
        </.link>
        <.link navigate={~p"/feeds/#{@feed_source}/edit"}>
          <.button>
            <.icon name="hero-pencil" class="h-4 w-4" /> Edit
          </.button>
        </.link>
      </:actions>
    </.header>

    <div class="mt-[var(--space-md)]">
      <div class="bg-base-200 space-y-[var(--space-xs)] p-[var(--space-sm)] rounded-lg">
        <div class="flex justify-between">
          <span class="font-medium">Refresh Interval:</span>
          <span>{@feed_source.refresh_interval} minutes</span>
        </div>
        <div class="flex justify-between">
          <span class="font-medium">Last Fetched:</span>
          <span>
            <%= if @feed_source.last_fetched_at do %>
              {relative_time(@feed_source.last_fetched_at)}
            <% else %>
              <span class="opacity-50">Never</span>
            <% end %>
          </span>
        </div>
        <%= if @feed_source.last_error do %>
          <div class="flex justify-between">
            <span class="text-error font-medium">Last Error:</span>
            <span class="text-error text-[var(--text-sm)]">{@feed_source.last_error}</span>
          </div>
        <% end %>
      </div>
    </div>

    <div class="mt-[var(--space-md)]">
      <h2 class="mb-[var(--space-sm)] text-[var(--text-xl)] font-semibold">
        Recent Items ({length(@feed_items)})
      </h2>

      <%= if Enum.empty?(@feed_items) do %>
        <div class="py-12 text-center opacity-60">
          <.icon name="hero-rss" class="mb-[var(--space-sm)] mx-auto h-12 w-12 opacity-50" />
          <p class="text-[var(--text-lg)]">No feed items yet</p>
          <p class="mt-[var(--space-xs)] text-[var(--text-sm)]">
            <%= if @feed_source.enabled do %>
              Items will appear here after the first fetch.
            <% else %>
              Enable this feed to start fetching items.
            <% end %>
          </p>
        </div>
      <% else %>
        <div class="space-y-[var(--space-sm)]">
          <%= for item <- @feed_items do %>
            <div class="border-base-300 bg-base-100 p-[var(--space-sm)] rounded-lg border transition-shadow hover:shadow-md">
              <div class="gap-[var(--space-sm)] flex items-start justify-between">
                <div class="flex-1">
                  <h3 class="text-[var(--text-lg)] font-semibold">
                    <%= if item.url do %>
                      <a href={item.url} target="_blank" class="link link-primary">
                        {item.title}
                      </a>
                    <% else %>
                      {item.title}
                    <% end %>
                  </h3>
                  <%= if item.author_name do %>
                    <p class="mt-[var(--space-xs)] text-[var(--text-sm)] opacity-70">
                      by {item.author_name}
                    </p>
                  <% end %>
                  <%= if item.content do %>
                    <div class="line-clamp-3 [&_img]:hidden mt-[var(--space-xs)] opacity-80">
                      {raw(item.content)}
                    </div>
                  <% end %>
                </div>
                <div class="text-[var(--text-sm)] whitespace-nowrap opacity-60">
                  {relative_time(item.published_at)}
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</Layouts.app>
