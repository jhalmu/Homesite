<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="technical-main">
    <.header>
      {@page_title}
      <:subtitle>{gettext("Configure your feed source settings")}</:subtitle>
      <:actions>
        <.link navigate={~p"/feeds"}>
          <.button>
            <.icon name="hero-arrow-left" class="h-4 w-4" /> {gettext("Back to Feeds")}
          </.button>
        </.link>
      </:actions>
    </.header>

    <.form
      for={@form}
      id="feed_source-form"
      phx-change="validate"
      phx-submit="save"
      class="mt-[var(--space-md)]"
    >
      <.input
        field={@form[:feed_type]}
        type="select"
        label={gettext("Feed Type")}
        options={feed_type_options()}
      />
      <.input field={@form[:name]} type="text" label={gettext("Name")} />

      <div :if={@form[:feed_type].value in ["rss", "atom", "json"]}>
        <.input
          field={@form[:url]}
          type="text"
          label={gettext("Feed URL")}
          placeholder={gettext("https://example.com/feed.xml")}
        />
      </div>

      <div :if={@form[:feed_type].value in ["bluesky", "mastodon"]}>
        <.input
          field={@form[:username]}
          type="text"
          label={gettext("Username")}
          placeholder={gettext("user.bsky.social or @user@mastodon.social")}
        />
      </div>

      <.input field={@form[:icon]} type="text" label={gettext("Icon (emoji)")} placeholder="📰" />
      <.input
        field={@form[:refresh_interval]}
        type="number"
        label={gettext("Refresh Interval (minutes)")}
        min="5"
        step="5"
      />
      <.input
        field={@form[:display_order]}
        type="number"
        label={gettext("Display Order")}
        min="0"
      />
      <.input field={@form[:enabled]} type="checkbox" label={gettext("Enabled")} />

      <div class="mt-[var(--space-lg)] gap-x-[var(--space-md)] flex items-center justify-end">
        <.link navigate={~p"/feeds"} class="text-[var(--text-sm)] font-semibold text-gray-900">
          {gettext("Cancel")}
        </.link>
        <.button phx-disable-with={gettext("Saving...")}>{gettext("Save Feed Source")}</.button>
      </div>
    </.form>
  </div>
</Layouts.app>
