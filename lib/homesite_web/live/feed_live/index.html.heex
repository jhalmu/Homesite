<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="technical-main">
    <.header>
      {gettext("Feed")}
      <:subtitle>
        {ngettext("1 unread item", "%{count} unread items", @unread_count)}
      </:subtitle>
      <:actions>
        <.button navigate={~p"/feeds"}>
          <.icon name="hero-cog-6-tooth" class="h-5 w-5" />
          {gettext("Manage Sources")}
        </.button>
      </:actions>
    </.header>
    
<!-- Filter controls -->
    <div class="my-[var(--space-md)] gap-[var(--space-sm)] flex flex-wrap items-center">
      <!-- Status filter tabs -->
      <div class="tabs tabs-boxed" role="tablist">
        <button
          type="button"
          role="tab"
          phx-click="filter_change"
          phx-value-filter="all"
          class={["tab", @filter == "all" && "tab-active"]}
          aria-selected={@filter == "all"}
        >
          {gettext("All")}
        </button>
        <button
          type="button"
          role="tab"
          phx-click="filter_change"
          phx-value-filter="unread"
          class={["tab", @filter == "unread" && "tab-active"]}
          aria-selected={@filter == "unread"}
        >
          {gettext("Unread")}
          <%= if @unread_count > 0 do %>
            <span class="badge badge-primary badge-sm ml-[var(--space-xs)]">{@unread_count}</span>
          <% end %>
        </button>
        <button
          type="button"
          role="tab"
          phx-click="filter_change"
          phx-value-filter="bookmarks"
          class={["tab", @filter == "bookmarks" && "tab-active"]}
          aria-selected={@filter == "bookmarks"}
        >
          {gettext("Bookmarks")}
        </button>
      </div>
      
<!-- Source filter dropdown -->
      <%= if length(@feed_sources) > 0 do %>
        <div class="gap-[var(--space-xs)] flex items-center">
          <span class="text-base-content/70 text-[var(--text-sm)]">{gettext("Filter by:")}</span>
          <div class="dropdown">
            <div
              tabindex="0"
              role="button"
              class="btn btn-sm btn-ghost gap-[var(--space-inline)]"
              aria-label={gettext("Filter by source")}
              aria-haspopup="listbox"
            >
              <%= if @source_id do %>
                <.icon name="hero-funnel-solid" class="text-primary h-4 w-4" />
                {@source_name}
              <% else %>
                <.icon name="hero-funnel" class="h-4 w-4" />
                {gettext("All sources")}
              <% end %>
              <.icon name="hero-chevron-down" class="h-3 w-3" />
            </div>
            <ul
              tabindex="0"
              class="dropdown-content menu bg-base-100 rounded-box z-[1] p-[var(--space-xs)] w-52 shadow"
            >
              <li>
                <.link
                  navigate={if @filter != "all", do: ~p"/feed?filter=#{@filter}", else: ~p"/feed"}
                  class={[!@source_id && "active"]}
                >
                  <.icon name="hero-squares-2x2" class="h-4 w-4" />
                  {gettext("All sources")}
                </.link>
              </li>
              <li class="menu-title"><span>{gettext("Sources")}</span></li>
              <%= for source <- @feed_sources do %>
                <li>
                  <.link
                    navigate={
                      if @filter != "all",
                        do: ~p"/feed?filter=#{@filter}&source=#{source.id}",
                        else: ~p"/feed?source=#{source.id}"
                    }
                    class={[to_string(@source_id) == to_string(source.id) && "active"]}
                  >
                    <span class="text-[var(--text-lg)]">{source.icon}</span>
                    {source.name}
                  </.link>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>
    </div>
    
<!-- Feed items list -->
    <div class="space-y-[var(--space-sm)]" id="feed-items-list">
      <%= if Enum.empty?(@items) do %>
        <div class="alert">
          <.icon name="hero-information-circle" class="h-6 w-6" />
          <span>
            <%= if @filter == "unread" do %>
              {gettext("No unread items. Great job!")}
            <% else %>
              <%= if @filter == "bookmarks" do %>
                {gettext("No bookmarked items yet.")}
              <% else %>
                {gettext("No feed items found. Add some feed sources to get started.")}
              <% end %>
            <% end %>
          </span>
        </div>
      <% else %>
        <div class="gap-[var(--spacing-md)] grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
          <%= for item <- @items do %>
            <article
              id={"feed-item-#{item.feed_item.id}"}
              class="listing-card card bg-base-200 duration-[var(--duration-normal)] border-base-300 border shadow-lg transition-shadow hover:shadow-xl"
            >
              <div class="card-body p-[var(--spacing-card)]">
                <%!-- Feed source badge --%>
                <div class="mb-[var(--spacing-sm)] gap-[var(--spacing-inline)] flex items-center">
                  <span class="text-[var(--font-size-fluid-lg)]">
                    {item.feed_item.feed_source.icon}
                  </span>
                  <span class="badge badge-sm badge-ghost">
                    {item.feed_item.feed_source.name}
                  </span>
                </div>

                <%!-- Item title --%>
                <h2 class="mb-[var(--spacing-sm)] text-[var(--font-size-fluid-lg)] line-clamp-[var(--space-xs)] font-semibold">
                  <a
                    href={item.feed_item.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="duration-[var(--duration-normal)] transition-colors hover:text-primary"
                    title={item.feed_item.title}
                  >
                    {item.feed_item.title}
                  </a>
                </h2>

                <%!-- Item metadata --%>
                <div class="text-[var(--text-xs)] gap-[var(--spacing-inline)] flex items-center opacity-70">
                  <time datetime={item.feed_item.published_at}>
                    {format_date(item.feed_item.published_at)}
                  </time>
                </div>

                <%!-- Actions (read/unread, bookmark, external link) --%>
                <div class="mt-[var(--spacing-sm)] pt-[var(--spacing-sm)] border-base-300 border-t">
                  <div class="gap-[var(--spacing-inline)] flex items-center justify-between">
                    <div class="gap-[var(--spacing-inline)] flex items-center">
                      <%= if read?(item) do %>
                        <button
                          phx-click="mark_unread"
                          phx-value-id={item.feed_item.id}
                          class="btn btn-xs btn-ghost gap-[var(--spacing-inline)]"
                          title={gettext("Mark as unread")}
                        >
                          <.icon name="hero-envelope" class="h-3 w-3" />
                        </button>
                      <% else %>
                        <button
                          phx-click="mark_read"
                          phx-value-id={item.feed_item.id}
                          class="btn btn-xs btn-ghost gap-[var(--spacing-inline)]"
                          title={gettext("Mark as read")}
                        >
                          <.icon name="hero-envelope-open" class="h-3 w-3" />
                        </button>
                      <% end %>

                      <button
                        phx-click="toggle_bookmark"
                        phx-value-id={item.feed_item.id}
                        class={[
                          "btn btn-xs btn-ghost gap-[var(--spacing-inline)]",
                          bookmarked?(item) && "text-warning"
                        ]}
                        title={
                          if bookmarked?(item),
                            do: gettext("Remove bookmark"),
                            else: gettext("Bookmark")
                        }
                      >
                        <%= if bookmarked?(item) do %>
                          <.icon name="hero-star-solid" class="h-3 w-3" />
                        <% else %>
                          <.icon name="hero-star" class="h-3 w-3" />
                        <% end %>
                      </button>
                    </div>

                    <a
                      href={item.feed_item.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn btn-xs btn-ghost gap-[var(--spacing-inline)]"
                    >
                      <.icon name="hero-arrow-top-right-on-square" class="h-3 w-3" />
                      {gettext("Read more")}
                    </a>
                  </div>
                </div>
              </div>
            </article>
          <% end %>
        </div>
      <% end %>
    </div>
    
<!-- Load more button -->
    <%= if @has_more do %>
      <div class="mt-[var(--space-lg)] text-center">
        <button phx-click="load_more" class="btn btn-outline">
          {gettext("Load More")}
        </button>
      </div>
    <% end %>
  </div>
</Layouts.app>
