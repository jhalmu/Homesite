<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <.header>
      {gettext("Feed")}
      <:subtitle>
        {ngettext("1 unread item", "%{count} unread items", @unread_count)}
      </:subtitle>
      <:actions>
        <.link navigate={~p"/feeds"} class="btn btn-ghost btn-sm">
          <.icon name="hero-cog-6-tooth" class="h-5 w-5" />
          {gettext("Manage Sources")}
        </.link>
      </:actions>
    </.header>
    
<!-- Filter controls -->
    <div class="my-6 flex flex-wrap items-center gap-4">
      <!-- Status filter tabs -->
      <div class="tabs tabs-boxed">
        <button
          phx-click="filter_change"
          phx-value-filter="all"
          class={["tab", @filter == "all" && "tab-active"]}
        >
          {gettext("All")}
        </button>
        <button
          phx-click="filter_change"
          phx-value-filter="unread"
          class={["tab", @filter == "unread" && "tab-active"]}
        >
          {gettext("Unread")}
          <%= if @unread_count > 0 do %>
            <span class="badge badge-primary badge-sm ml-2">{@unread_count}</span>
          <% end %>
        </button>
        <button
          phx-click="filter_change"
          phx-value-filter="bookmarks"
          class={["tab", @filter == "bookmarks" && "tab-active"]}
        >
          {gettext("Bookmarks")}
        </button>
      </div>
      
<!-- Source filter dropdown -->
      <%= if length(@feed_sources) > 0 do %>
        <div class="flex items-center gap-2">
          <span class="text-base-content/70 text-sm">{gettext("Filter by:")}</span>
          <div class="dropdown">
            <div tabindex="0" role="button" class="btn btn-sm btn-ghost gap-1">
              <%= if @source_id do %>
                <.icon name="hero-funnel-solid" class="text-primary h-4 w-4" />
                {@source_name}
              <% else %>
                <.icon name="hero-funnel" class="h-4 w-4" />
                {gettext("All sources")}
              <% end %>
              <.icon name="hero-chevron-down" class="h-3 w-3" />
            </div>
            <ul
              tabindex="0"
              class="dropdown-content menu bg-base-100 rounded-box z-[1] w-52 p-2 shadow"
            >
              <li>
                <.link
                  navigate={if @filter != "all", do: ~p"/feed?filter=#{@filter}", else: ~p"/feed"}
                  class={[!@source_id && "active"]}
                >
                  <.icon name="hero-squares-2x2" class="h-4 w-4" />
                  {gettext("All sources")}
                </.link>
              </li>
              <li class="menu-title"><span>{gettext("Sources")}</span></li>
              <%= for source <- @feed_sources do %>
                <li>
                  <.link
                    navigate={
                      if @filter != "all",
                        do: ~p"/feed?filter=#{@filter}&source=#{source.id}",
                        else: ~p"/feed?source=#{source.id}"
                    }
                    class={[to_string(@source_id) == to_string(source.id) && "active"]}
                  >
                    <span class="text-lg">{source.icon}</span>
                    {source.name}
                  </.link>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>
    </div>
    
<!-- Feed items list -->
    <div class="space-y-4" id="feed-items-list">
      <%= if Enum.empty?(@items) do %>
        <div class="alert">
          <.icon name="hero-information-circle" class="h-6 w-6" />
          <span>
            <%= if @filter == "unread" do %>
              {gettext("No unread items. Great job!")}
            <% else %>
              <%= if @filter == "bookmarks" do %>
                {gettext("No bookmarked items yet.")}
              <% else %>
                {gettext("No feed items found. Add some feed sources to get started.")}
              <% end %>
            <% end %>
          </span>
        </div>
      <% else %>
        <%= for item <- @items do %>
          <div
            id={"feed-item-#{item.feed_item.id}"}
            class={[
              "card bg-base-100 border shadow-sm",
              is_read?(item) && "opacity-60",
              !is_read?(item) && "border-primary border-l-4"
            ]}
          >
            <div class="card-body">
              <!-- Feed source badge -->
              <div class="text-base-content/70 flex items-center gap-2 text-sm">
                <.link
                  navigate={~p"/feed?source=#{item.feed_item.feed_source.id}"}
                  class="badge badge-ghost badge-sm cursor-pointer hover:badge-primary"
                >
                  {item.feed_item.feed_source.name}
                </.link>
                <span>•</span>
                <time datetime={item.feed_item.published_at}>
                  {format_relative_time(item.feed_item.published_at)}
                </time>
              </div>
              
<!-- Title -->
              <h2 class={["card-title", !is_read?(item) && "font-bold"]}>
                <a
                  href={item.feed_item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="link link-hover"
                >
                  {item.feed_item.title}
                </a>
              </h2>
              
<!-- Content with optional image -->
              <div class="flex gap-4">
                <!-- Image thumbnail if available -->
                <%= if item.feed_item.metadata["image_url"] do %>
                  <div class="shrink-0">
                    <img
                      src={item.feed_item.metadata["image_url"]}
                      alt=""
                      class="h-12 w-12 rounded object-cover"
                      loading="lazy"
                      onerror="this.style.display='none'"
                    />
                  </div>
                <% end %>
                
<!-- Description/Summary - only show if different from title -->
                <div class="flex-1">
                  <%= if item.feed_item.content && item.feed_item.content != item.feed_item.title do %>
                    <div class="text-base-content/80 line-clamp-3 prose prose-sm max-w-none">
                      {raw(item.feed_item.content)}
                    </div>
                  <% else %>
                    <!-- For title-only items, show the URL domain as context -->
                    <div class="text-base-content/60 text-sm">
                      <.icon name="hero-link" class="inline h-4 w-4" />
                      {URI.parse(item.feed_item.url).host}
                    </div>
                  <% end %>
                </div>
              </div>
              
<!-- Platform-specific metadata -->
              <%= if item.feed_item.metadata do %>
                {render_metadata(item.feed_item)}
              <% end %>
              
<!-- Actions -->
              <div class="card-actions mt-4 justify-end">
                <%= if is_read?(item) do %>
                  <button
                    phx-click="mark_unread"
                    phx-value-id={item.feed_item.id}
                    class="btn btn-ghost btn-sm"
                    title={gettext("Mark as unread")}
                  >
                    <.icon name="hero-envelope" class="h-4 w-4" />
                  </button>
                <% else %>
                  <button
                    phx-click="mark_read"
                    phx-value-id={item.feed_item.id}
                    class="btn btn-ghost btn-sm"
                    title={gettext("Mark as read")}
                  >
                    <.icon name="hero-envelope-open" class="h-4 w-4" />
                  </button>
                <% end %>

                <button
                  phx-click="toggle_bookmark"
                  phx-value-id={item.feed_item.id}
                  class={["btn btn-ghost btn-sm", is_bookmarked?(item) && "text-warning"]}
                  title={
                    if is_bookmarked?(item),
                      do: gettext("Remove bookmark"),
                      else: gettext("Bookmark")
                  }
                >
                  <%= if is_bookmarked?(item) do %>
                    <.icon name="hero-star-solid" class="h-4 w-4" />
                  <% else %>
                    <.icon name="hero-star" class="h-4 w-4" />
                  <% end %>
                </button>

                <a
                  href={item.feed_item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-primary btn-sm"
                >
                  {gettext("Open")}
                  <.icon name="hero-arrow-top-right-on-square" class="h-4 w-4" />
                </a>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
    
<!-- Load more button -->
    <%= if @has_more do %>
      <div class="mt-8 text-center">
        <button phx-click="load_more" class="btn btn-outline">
          {gettext("Load More")}
        </button>
      </div>
    <% end %>
  </div>
</Layouts.app>
