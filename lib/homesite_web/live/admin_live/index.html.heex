<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="technical-main">
    <!-- Header with Flowers -->
    <div class="gap-[var(--spacing-md)] mb-[var(--spacing-section)] flex flex-col">
      <div class="gap-[var(--spacing-md)] flex items-center">
        <h1 class="text-[var(--font-size-fluid-2xl)] font-bold">
          {gettext("Admin Dashboard")}
        </h1>
        <div
          class="text-[var(--font-size-fluid-2xl)]"
          title={gettext("Admin Level %{level}", level: @flower_count)}
        >
          {@flowers}
        </div>
      </div>

      <div class="alert alert-success">
        <.icon name="hero-shield-check" class="h-6 w-6" />
        <div>
          <p class="font-semibold">{gettext("Admin Access Granted")}</p>
          <p class="text-[var(--text-sm)]">
            {gettext("You have %{count} flower(s) - Admin Level %{level}",
              count: @flower_count,
              level: @flower_count
            )}
          </p>
        </div>
      </div>
    </div>
    
<!-- Stats Overview -->
    <div class="mb-[var(--spacing-section)]">
      <h2 class="text-[var(--font-size-fluid-xl)] mb-[var(--spacing-md)] font-semibold">
        {gettext("System Overview")}
      </h2>

      <div class="gap-[var(--spacing-md)] grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
        <!-- Total Users -->
        <div class="stats bg-base-200 shadow">
          <div class="stat">
            <div class="stat-figure text-primary">
              <.icon name="hero-users" class="h-8 w-8" />
            </div>
            <div class="stat-title">{gettext("Total Users")}</div>
            <div class="stat-value text-primary">{@total_users}</div>
            <div class="stat-desc">{gettext("Registered users")}</div>
          </div>
        </div>
        
<!-- Admin Users -->
        <div class="stats bg-base-200 shadow">
          <div class="stat">
            <div class="stat-figure text-secondary">
              <.icon name="hero-shield-check" class="h-8 w-8" />
            </div>
            <div class="stat-title">{gettext("Admins")}</div>
            <div class="stat-value text-secondary">{@admin_count}</div>
            <div class="stat-desc">{gettext("With admin access")}</div>
          </div>
        </div>
        
<!-- Your Level -->
        <div class="stats bg-base-200 shadow">
          <div class="stat">
            <div class="stat-figure text-accent">
              <span class="text-[var(--font-size-fluid-xl)]">🌸</span>
            </div>
            <div class="stat-title">{gettext("Your Level")}</div>
            <div class="stat-value text-accent">{@flower_count}</div>
            <div class="stat-desc">{gettext("Flower permissions")}</div>
          </div>
        </div>
      </div>
    </div>
    
<!-- Mini Charts Section -->
    <div class="mb-[var(--spacing-section)]">
      <h2 class="text-[var(--font-size-fluid-xl)] mb-[var(--spacing-md)] font-semibold">
        {gettext("Quick Insights")}
      </h2>

      <div class="gap-[var(--spacing-md)] grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
        <!-- Activity Sparkline -->
        <%= if length(@activity_trend) > 0 do %>
          <div class="card bg-base-200 shadow">
            <div class="card-body p-[var(--space-md)]">
              <h3 class="card-title text-[var(--text-base)]">
                <.icon name="hero-arrow-trending-up" class="h-5 w-5" />
                {gettext("Activity (7 days)")}
              </h3>
              <div class="h-20">
                <div
                  id="admin-activity-sparkline"
                  phx-hook="ApexChart"
                  phx-update="ignore"
                  data-chart={activity_sparkline_data(@activity_trend)}
                >
                </div>
              </div>
            </div>
          </div>
        <% end %>
        
<!-- Users Breakdown -->
        <div class="card bg-base-200 shadow">
          <div class="card-body p-[var(--space-md)]">
            <h3 class="card-title text-[var(--text-base)]">
              <.icon name="hero-users" class="h-5 w-5" />
              {gettext("User Breakdown")}
            </h3>
            <div class="h-36">
              <div
                id="admin-users-donut"
                phx-hook="ApexChart"
                phx-update="ignore"
                data-chart={users_donut_data(@total_users, @admin_count)}
              >
              </div>
            </div>
          </div>
        </div>
        
<!-- Content Breakdown -->
        <div class="card bg-base-200 shadow">
          <div class="card-body p-[var(--space-md)]">
            <h3 class="card-title text-[var(--text-base)]">
              <.icon name="hero-document-text" class="h-5 w-5" />
              {gettext("Content Status")}
            </h3>
            <div class="h-36">
              <div
                id="admin-content-donut"
                phx-hook="ApexChart"
                phx-update="ignore"
                data-chart={content_donut_data(@content_stats)}
              >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
<!-- Quick Actions -->
    <div class="mb-[var(--spacing-section)]">
      <h2 class="text-[var(--font-size-fluid-xl)] mb-[var(--spacing-md)] font-semibold">
        {gettext("Admin Actions")}
      </h2>

      <div class="gap-[var(--spacing-sm)] flex flex-wrap">
        <.link navigate={~p"/dashboard"} class="btn btn-outline gap-[var(--space-xs)]">
          <.icon name="hero-home" class="h-5 w-5" /> {gettext("Back to User Dashboard")}
        </.link>

        <.link navigate={~p"/admin/analytics"} class="btn btn-primary gap-[var(--space-xs)]">
          <.icon name="hero-chart-bar" class="h-5 w-5" /> {gettext("Analytics")}
        </.link>

        <%= if @flower_count >= 3 do %>
          <.link navigate={~p"/admin/users"} class="btn btn-primary gap-[var(--space-xs)]">
            <.icon name="hero-users" class="h-5 w-5" /> {gettext("Manage Users")}
          </.link>
        <% end %>

        <.link navigate={~p"/posts"} class="btn btn-outline gap-[var(--space-xs)]">
          <.icon name="hero-document-text" class="h-5 w-5" /> {gettext("View All Posts")}
        </.link>
        <.link navigate={~p"/tags"} class="btn btn-outline gap-[var(--space-xs)]">
          <.icon name="hero-tag" class="h-5 w-5" /> {gettext("View All Tags")}
        </.link>
      </div>
    </div>
    
<!-- Permissions Info -->
    <div class="card bg-base-200 shadow-xl">
      <div class="card-body">
        <h2 class="card-title">{gettext("Flower Permission System")} 🌸</h2>
        <div class="space-y-[var(--space-xs)]">
          <p><strong>{gettext("Level 1 (🌸):")} </strong>{gettext("Basic admin access")}</p>
          <p><strong>{gettext("Level 2 (🌸🌸):")} </strong>{gettext("Content moderation")}</p>
          <p>
            <strong>{gettext("Level 3 (🌸🌸🌸):")} </strong>{gettext("User management")}
          </p>
          <p>
            <strong>{gettext("Level 4 (🌸🌸🌸🌸):")} </strong>{gettext(
              "System configuration"
            )}
          </p>
          <p>
            <strong>{gettext("Level 5 (🌸🌸🌸🌸🌸):")} </strong>{gettext(
              "Full administrative access"
            )}
          </p>
        </div>
        <div class="card-actions mt-[var(--space-sm)] justify-end">
          <span class="badge badge-lg badge-primary">
            {gettext("Your level:")}{@flower_count}
          </span>
        </div>
      </div>
    </div>
  </div>
</Layouts.app>
