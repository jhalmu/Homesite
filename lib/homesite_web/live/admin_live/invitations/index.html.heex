<div class="mx-auto max-w-6xl">
  <div class="mb-6 flex items-center justify-between">
    <h1 class="text-3xl font-bold">Manage Invitations</h1>
    <.link
      :if={@form == nil}
      phx-click="new"
      class="btn btn-primary"
    >
      <.icon name="hero-plus" class="mr-2 h-5 w-5" /> Create Invitation
    </.link>
  </div>

  <%= if @form do %>
    <div class="card bg-base-100 mb-6 shadow-xl">
      <div class="card-body">
        <h2 class="card-title">New Invitation</h2>

        <.form
          for={@form}
          id="invitation-form"
          phx-submit="create"
        >
          <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <.input
              field={@form[:code]}
              type="text"
              label="Invitation Code"
              placeholder="Leave empty to auto-generate"
              phx-debounce="blur"
            />

            <.input
              field={@form[:max_uses]}
              type="number"
              label="Max Uses"
              placeholder="Leave empty for unlimited"
              min="1"
              phx-debounce="blur"
            />

            <.input
              field={@form[:expires_at]}
              type="datetime-local"
              label="Expires At"
              placeholder="Leave empty for no expiration"
              phx-debounce="blur"
            />

            <.input
              field={@form[:default_role]}
              type="select"
              label="Default Role"
              options={[{"User", "user"}, {"Admin", "admin"}]}
            />
          </div>

          <div class="card-actions mt-4 justify-end">
            <button type="button" phx-click="cancel" class="btn btn-ghost">
              Cancel
            </button>
            <button type="submit" class="btn btn-primary">
              Create Invitation
            </button>
          </div>
        </.form>
      </div>
    </div>
  <% end %>

  <div class="card bg-base-100 shadow-xl">
    <div class="card-body">
      <h2 class="card-title mb-4">Active Invitations</h2>

      <%= if @invitations == [] do %>
        <div class="text-base-content/60 py-8 text-center">
          <.icon name="hero-ticket" class="mx-auto mb-4 h-16 w-16 opacity-50" />
          <p>No invitations yet. Create one to get started.</p>
        </div>
      <% else %>
        <div class="overflow-x-auto">
          <table class="table-zebra table">
            <thead>
              <tr>
                <th>Code</th>
                <th>Created By</th>
                <th>Uses</th>
                <th>Expires</th>
                <th>Role</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <%= for invitation <- @invitations do %>
                <tr>
                  <td>
                    <code class="font-mono text-primary font-bold">
                      {invitation.code}
                    </code>
                    <button
                      type="button"
                      class="btn btn-xs btn-ghost ml-2"
                      phx-click="copy"
                      phx-value-code={invitation.code}
                      onclick={"navigator.clipboard.writeText('#{invitation.code}')"}
                      title="Copy code"
                    >
                      <.icon name="hero-clipboard" class="h-4 w-4" />
                    </button>
                  </td>
                  <td>{invitation.created_by.email}</td>
                  <td>
                    {invitation.current_uses}
                    <%= if invitation.max_uses do %>
                      / {invitation.max_uses}
                    <% else %>
                      / ∞
                    <% end %>
                  </td>
                  <td>
                    <%= if invitation.expires_at do %>
                      {Calendar.strftime(invitation.expires_at, "%B %d, %Y at %H:%M")}
                    <% else %>
                      Never
                    <% end %>
                  </td>
                  <td>
                    <span class="badge badge-sm">
                      {invitation.default_role}
                    </span>
                  </td>
                  <td>
                    <%= cond do %>
                      <% !Homesite.Accounts.Invitation.not_expired?(invitation) -> %>
                        <span class="badge badge-error">Expired</span>
                      <% !Homesite.Accounts.Invitation.not_exhausted?(invitation) -> %>
                        <span class="badge badge-warning">Exhausted</span>
                      <% true -> %>
                        <span class="badge badge-success">Active</span>
                    <% end %>
                  </td>
                  <td>
                    <button
                      type="button"
                      phx-click="delete"
                      phx-value-id={invitation.id}
                      data-confirm="Are you sure you want to delete this invitation?"
                      class="btn btn-xs btn-error"
                    >
                      <.icon name="hero-trash" class="h-4 w-4" />
                    </button>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </div>
</div>
