<div class="technical-main">
  <div class="mb-[var(--space-md)] flex items-center justify-between">
    <h1 class="text-[var(--text-2xl)] font-bold">{gettext("Manage Invitations")}</h1>
    <.link
      :if={@form == nil}
      phx-click="new"
      class="btn btn-primary"
    >
      <.icon name="hero-plus" class="mr-[var(--space-xs)] h-5 w-5" /> {gettext(
        "Create Invitation"
      )}
    </.link>
  </div>

  <%= if @form do %>
    <div class="card bg-base-100 mb-[var(--space-md)] shadow-xl">
      <div class="card-body">
        <h2 class="card-title">{gettext("New Invitation")}</h2>

        <.form
          for={@form}
          id="invitation-form"
          phx-submit="create"
        >
          <div class="gap-[var(--space-sm)] grid grid-cols-1 md:grid-cols-2">
            <.input
              field={@form[:code]}
              type="text"
              label={gettext("Invitation Code")}
              placeholder={gettext("Leave empty to auto-generate")}
              phx-debounce="blur"
            />

            <.input
              field={@form[:max_uses]}
              type="number"
              label={gettext("Max Uses")}
              placeholder={gettext("Leave empty for unlimited")}
              min="1"
              phx-debounce="blur"
            />

            <.input
              field={@form[:expires_at]}
              type="datetime-local"
              label={gettext("Expires At")}
              value={@default_expires_at}
              phx-debounce="blur"
            />

            <.input
              field={@form[:default_role]}
              type="select"
              label={gettext("Default Role")}
              options={[{gettext("User"), "user"}, {gettext("Admin"), "admin"}]}
            />
          </div>

          <div class="card-actions mt-[var(--space-sm)] justify-end">
            <button type="button" phx-click="cancel" class="btn btn-ghost">
              {gettext("Cancel")}
            </button>
            <button type="submit" class="btn btn-primary">
              {gettext("Create Invitation")}
            </button>
          </div>
        </.form>
      </div>
    </div>
  <% end %>

  <div class="card bg-base-100 shadow-xl">
    <div class="card-body">
      <h2 class="card-title mb-[var(--space-sm)]">{gettext("Active Invitations")}</h2>

      <%= if @invitations == [] do %>
        <div class="text-base-content/60 py-[var(--space-lg)] text-center">
          <.icon name="hero-ticket" class="mb-[var(--space-sm)] mx-auto h-16 w-16 opacity-50" />
          <p>{gettext("No invitations yet. Create one to get started.")}</p>
        </div>
      <% else %>
        <div class="overflow-x-auto">
          <table class="table-zebra table">
            <thead>
              <tr>
                <th>{gettext("Code")}</th>
                <th>{gettext("Created By")}</th>
                <th>{gettext("Uses")}</th>
                <th>{gettext("Expires")}</th>
                <th>{gettext("Role")}</th>
                <th>{gettext("Status")}</th>
                <th>{gettext("Actions")}</th>
              </tr>
            </thead>
            <tbody>
              <%= for invitation <- @invitations do %>
                <tr>
                  <td>
                    <code class="font-mono text-primary font-bold">
                      {invitation.code}
                    </code>
                    <div class="mt-[var(--space-inline)] gap-[var(--space-inline)] flex">
                      <button
                        type="button"
                        class="btn btn-xs btn-ghost"
                        phx-click="copy"
                        phx-value-code={invitation.code}
                        onclick={"navigator.clipboard.writeText('#{invitation.code}')"}
                        title={gettext("Copy code only")}
                        aria-label={gettext("Copy code")}
                      >
                        <.icon name="hero-clipboard" class="h-4 w-4" /> {gettext("Code")}
                      </button>
                      <button
                        type="button"
                        class="btn btn-xs btn-primary"
                        phx-click="copy_link"
                        phx-value-code={invitation.code}
                        onclick={"navigator.clipboard.writeText('#{HomesiteWeb.Endpoint.url()}/users/register?invite=#{invitation.code}')"}
                        title={gettext("Copy registration link")}
                        aria-label={gettext("Copy registration link")}
                      >
                        <.icon name="hero-link" class="h-4 w-4" /> {gettext("Link")}
                      </button>
                    </div>
                  </td>
                  <td>{invitation.created_by.email}</td>
                  <td>
                    {invitation.current_uses}
                    <%= if invitation.max_uses do %>
                      / {invitation.max_uses}
                    <% else %>
                      / ∞
                    <% end %>
                  </td>
                  <td>
                    <%= if invitation.expires_at do %>
                      {format_datetime(invitation.expires_at)}
                    <% else %>
                      {gettext("Never")}
                    <% end %>
                  </td>
                  <td>
                    <span class="badge badge-sm">
                      {invitation.default_role}
                    </span>
                  </td>
                  <td>
                    <%= cond do %>
                      <% !Homesite.Accounts.Invitation.not_expired?(invitation) -> %>
                        <span class="badge badge-error">{gettext("Expired")}</span>
                      <% !Homesite.Accounts.Invitation.not_exhausted?(invitation) -> %>
                        <span class="badge badge-warning">{gettext("Exhausted")}</span>
                      <% true -> %>
                        <span class="badge badge-success">{gettext("Active")}</span>
                    <% end %>
                  </td>
                  <td>
                    <button
                      type="button"
                      phx-click="delete"
                      phx-value-id={invitation.id}
                      data-confirm={gettext("Are you sure you want to delete this invitation?")}
                      class="btn btn-xs btn-error"
                      aria-label={gettext("Delete invitation")}
                    >
                      <.icon name="hero-trash" class="h-4 w-4" />
                    </button>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </div>
</div>
