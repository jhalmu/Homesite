<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.header>
    {gettext("Analytics Dashboard")}
    <:subtitle>{gettext("Platform statistics and trends")}</:subtitle>
  </.header>

  <div class="mt-[var(--space-lg)] space-y-[var(--space-lg)]">
    <%!-- User Metrics --%>
    <section>
      <h2 class="mb-[var(--space-sm)] text-[var(--text-xl)] font-semibold">
        {gettext("User Metrics")}
      </h2>
      <div class="gap-[var(--space-sm)] grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4">
        <.stat_card
          title={gettext("Total Users")}
          value={@user_stats.total_users}
          icon="hero-users"
          color="bg-blue-100 text-blue-800"
        />
        <.stat_card
          title={gettext("New (7 days)")}
          value={@user_stats.new_users_7d}
          icon="hero-user-plus"
          color="bg-green-100 text-green-800"
        />
        <.stat_card
          title={gettext("New (30 days)")}
          value={@user_stats.new_users_30d}
          icon="hero-user-plus"
          color="bg-green-100 text-green-800"
        />
        <.stat_card
          title={gettext("Admins")}
          value={@user_stats.admin_count}
          icon="hero-shield-check"
          color="bg-purple-100 text-purple-800"
        />
      </div>
    </section>

    <%!-- Content Metrics --%>
    <section>
      <h2 class="mb-[var(--space-sm)] text-[var(--text-xl)] font-semibold">
        {gettext("Content Metrics")}
      </h2>
      <div class="gap-[var(--space-sm)] grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4">
        <.stat_card
          title={gettext("Total Posts")}
          value={@content_stats.total_posts}
          icon="hero-document-text"
          color="bg-indigo-100 text-indigo-800"
        />
        <.stat_card
          title={gettext("Drafts")}
          value={@content_stats.total_drafts}
          icon="hero-document"
          color="bg-gray-100 text-gray-800"
        />
        <.stat_card
          title={gettext("Posts (7 days)")}
          value={@content_stats.posts_7d}
          icon="hero-calendar"
          color="bg-teal-100 text-teal-800"
        />
        <.stat_card
          title={gettext("Posts (30 days)")}
          value={@content_stats.posts_30d}
          icon="hero-calendar-days"
          color="bg-teal-100 text-teal-800"
        />
        <.stat_card
          title={gettext("Total Tags")}
          value={@content_stats.total_tags}
          icon="hero-tag"
          color="bg-yellow-100 text-yellow-800"
        />
        <.stat_card
          title={gettext("Avg Post Length")}
          value={"#{@content_stats.avg_post_length} #{gettext("chars")}"}
          icon="hero-document-text"
          color="bg-orange-100 text-orange-800"
        />
      </div>
    </section>

    <%!-- Geographic Analytics --%>
    <section>
      <h2 class="mb-[var(--space-sm)] text-[var(--text-xl)] font-semibold">
        <.icon name="hero-globe-alt" class="mr-[var(--space-xs)] inline h-6 w-6" />
        {gettext("Geographic Analytics")}
      </h2>
      <div class="gap-[var(--space-sm)] grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4">
        <.stat_card
          title={gettext("Countries")}
          value={@geo_stats.activity_logs.unique_countries || 0}
          icon="hero-flag"
          color="bg-emerald-100 text-emerald-800"
        />
        <.stat_card
          title={gettext("Cities")}
          value={@geo_stats.activity_logs.unique_cities || 0}
          icon="hero-building-office-2"
          color="bg-cyan-100 text-cyan-800"
        />
        <.stat_card
          title={gettext("Geo Coverage")}
          value={"#{if @geo_stats.activity_logs.total > 0, do: round(@geo_stats.activity_logs.with_country / @geo_stats.activity_logs.total * 100), else: 0}%"}
          icon="hero-chart-pie"
          color="bg-violet-100 text-violet-800"
        />
        <.stat_card
          title={gettext("Search Locations")}
          value={@geo_stats.search_queries.with_country || 0}
          icon="hero-magnifying-glass"
          color="bg-amber-100 text-amber-800"
        />
      </div>

      <div class="mt-[var(--space-md)] gap-[var(--space-md)] grid grid-cols-1 lg:grid-cols-2">
        <%!-- Visitors by Country --%>
        <%= if length(@visitors_by_country) > 0 do %>
          <div class="card bg-base-100 shadow-sm">
            <div class="card-body">
              <h3 class="card-title text-[var(--text-lg)]">
                {gettext("Top Countries")}
              </h3>
              <div class="overflow-x-auto">
                <table class="table-zebra table-sm table w-full">
                  <thead>
                    <tr>
                      <th>{gettext("Country")}</th>
                      <th class="text-right">{gettext("Actions")}</th>
                      <th class="text-right">{gettext("Users")}</th>
                    </tr>
                  </thead>
                  <tbody>
                    <%= for stat <- @visitors_by_country do %>
                      <tr>
                        <td>
                          <span class="mr-[var(--space-xs)]">{country_flag(stat.country)}</span>
                          {stat.country}
                        </td>
                        <td class="text-right">
                          <span class="badge badge-primary badge-sm">{stat.count}</span>
                        </td>
                        <td class="text-right">
                          <span class="badge badge-ghost badge-sm">{stat.unique_users}</span>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        <% end %>

        <%!-- Visitors by City --%>
        <%= if length(@visitors_by_city) > 0 do %>
          <div class="card bg-base-100 shadow-sm">
            <div class="card-body">
              <h3 class="card-title text-[var(--text-lg)]">
                {gettext("Top Cities")}
              </h3>
              <div class="overflow-x-auto">
                <table class="table-zebra table-sm table w-full">
                  <thead>
                    <tr>
                      <th>{gettext("City")}</th>
                      <th>{gettext("Country")}</th>
                      <th class="text-right">{gettext("Actions")}</th>
                    </tr>
                  </thead>
                  <tbody>
                    <%= for stat <- @visitors_by_city do %>
                      <tr>
                        <td>{stat.city}</td>
                        <td>
                          <span class="mr-[var(--space-xs)]">{country_flag(stat.country)}</span>
                          {stat.country}
                        </td>
                        <td class="text-right">
                          <span class="badge badge-primary badge-sm">{stat.count}</span>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </section>

    <%!-- Top Authors --%>
    <section>
      <h2 class="mb-[var(--space-sm)] text-[var(--text-xl)] font-semibold">
        {gettext("Top Authors")}
      </h2>
      <div class="overflow-x-auto">
        <table class="table-zebra table w-full">
          <thead>
            <tr>
              <th>{gettext("Email")}</th>
              <th>{gettext("Post Count")}</th>
            </tr>
          </thead>
          <tbody>
            <%= for author <- @content_stats.top_authors do %>
              <tr>
                <td>{author.email}</td>
                <td><span class="badge badge-primary">{author.post_count}</span></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

    <%!-- Popular Tags --%>
    <section>
      <h2 class="mb-[var(--space-sm)] text-[var(--text-xl)] font-semibold">
        {gettext("Popular Tags")}
      </h2>
      <div class="gap-[var(--space-xs)] flex flex-wrap">
        <%= for tag <- @content_stats.popular_tags do %>
          <span class="badge badge-lg gap-[var(--space-xs)]">
            {tag.name}
            <span class="badge badge-sm">{tag.usage_count}</span>
          </span>
        <% end %>
      </div>
    </section>

    <%!-- Share Statistics --%>
    <%= if length(@share_stats) > 0 do %>
      <section>
        <h2 class="mb-[var(--space-sm)] text-[var(--text-xl)] font-semibold">
          {gettext("Share Statistics")}
        </h2>
        <div class="overflow-x-auto">
          <table class="table-zebra table w-full">
            <thead>
              <tr>
                <th>{gettext("Post")}</th>
                <th>{gettext("Share Count")}</th>
              </tr>
            </thead>
            <tbody>
              <%= for stat <- Enum.take(@share_stats, 10) do %>
                <tr>
                  <td>{stat.post_title}</td>
                  <td><span class="badge badge-success">{stat.share_count}</span></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    <% end %>

    <%!-- Recent Shares --%>
    <%= if length(@recent_shares) > 0 do %>
      <section>
        <h2 class="mb-[var(--space-sm)] text-[var(--text-xl)] font-semibold">
          {gettext("Recent Shares")}
        </h2>
        <div class="overflow-x-auto">
          <table class="table-zebra table w-full">
            <thead>
              <tr>
                <th>{gettext("Platform")}</th>
                <th>{gettext("Post")}</th>
                <th>{gettext("Time")}</th>
              </tr>
            </thead>
            <tbody>
              <%= for share <- @recent_shares do %>
                <tr>
                  <td><span class="badge">{share.platform}</span></td>
                  <td>{if share.post, do: share.post.title, else: gettext("N/A")}</td>
                  <td class="text-[var(--text-sm)] text-gray-600">
                    {format_datetime(share.inserted_at)}
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    <% end %>
  </div>
</Layouts.app>
