<Layouts.app flash={@flash} current_scope={@current_scope}>
  <.header>
    Analytics Dashboard
    <:subtitle>Platform statistics and trends</:subtitle>
  </.header>

  <div class="mt-8 space-y-8">
    <%!-- User Metrics --%>
    <section>
      <h2 class="mb-4 text-2xl font-semibold">User Metrics</h2>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
        <.stat_card
          title="Total Users"
          value={@user_stats.total_users}
          icon="hero-users"
          color="bg-blue-100 text-blue-800"
        />
        <.stat_card
          title="New (7 days)"
          value={@user_stats.new_users_7d}
          icon="hero-user-plus"
          color="bg-green-100 text-green-800"
        />
        <.stat_card
          title="New (30 days)"
          value={@user_stats.new_users_30d}
          icon="hero-user-plus"
          color="bg-green-100 text-green-800"
        />
        <.stat_card
          title="Admins"
          value={@user_stats.admin_count}
          icon="hero-shield-check"
          color="bg-purple-100 text-purple-800"
        />
      </div>
    </section>

    <%!-- Content Metrics --%>
    <section>
      <h2 class="mb-4 text-2xl font-semibold">Content Metrics</h2>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
        <.stat_card
          title="Total Posts"
          value={@content_stats.total_posts}
          icon="hero-document-text"
          color="bg-indigo-100 text-indigo-800"
        />
        <.stat_card
          title="Drafts"
          value={@content_stats.total_drafts}
          icon="hero-document"
          color="bg-gray-100 text-gray-800"
        />
        <.stat_card
          title="Posts (7 days)"
          value={@content_stats.posts_7d}
          icon="hero-calendar"
          color="bg-teal-100 text-teal-800"
        />
        <.stat_card
          title="Posts (30 days)"
          value={@content_stats.posts_30d}
          icon="hero-calendar-days"
          color="bg-teal-100 text-teal-800"
        />
        <.stat_card
          title="Total Tags"
          value={@content_stats.total_tags}
          icon="hero-tag"
          color="bg-yellow-100 text-yellow-800"
        />
        <.stat_card
          title="Avg Post Length"
          value={"#{@content_stats.avg_post_length} chars"}
          icon="hero-document-text"
          color="bg-orange-100 text-orange-800"
        />
      </div>
    </section>

    <%!-- Top Authors --%>
    <section>
      <h2 class="mb-4 text-2xl font-semibold">Top Authors</h2>
      <div class="overflow-x-auto">
        <table class="table-zebra table w-full">
          <thead>
            <tr>
              <th>Email</th>
              <th>Post Count</th>
            </tr>
          </thead>
          <tbody>
            <%= for author <- @content_stats.top_authors do %>
              <tr>
                <td>{author.email}</td>
                <td><span class="badge badge-primary">{author.post_count}</span></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>

    <%!-- Popular Tags --%>
    <section>
      <h2 class="mb-4 text-2xl font-semibold">Popular Tags</h2>
      <div class="flex flex-wrap gap-2">
        <%= for tag <- @content_stats.popular_tags do %>
          <span class="badge badge-lg gap-2">
            {tag.name}
            <span class="badge badge-sm">{tag.usage_count}</span>
          </span>
        <% end %>
      </div>
    </section>

    <%!-- Share Statistics --%>
    <%= if length(@share_stats) > 0 do %>
      <section>
        <h2 class="mb-4 text-2xl font-semibold">Share Statistics</h2>
        <div class="overflow-x-auto">
          <table class="table-zebra table w-full">
            <thead>
              <tr>
                <th>Post</th>
                <th>Share Count</th>
              </tr>
            </thead>
            <tbody>
              <%= for stat <- Enum.take(@share_stats, 10) do %>
                <tr>
                  <td>{stat.post_title}</td>
                  <td><span class="badge badge-success">{stat.share_count}</span></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    <% end %>

    <%!-- Recent Shares --%>
    <%= if length(@recent_shares) > 0 do %>
      <section>
        <h2 class="mb-4 text-2xl font-semibold">Recent Shares</h2>
        <div class="overflow-x-auto">
          <table class="table-zebra table w-full">
            <thead>
              <tr>
                <th>Platform</th>
                <th>Post</th>
                <th>Time</th>
              </tr>
            </thead>
            <tbody>
              <%= for share <- @recent_shares do %>
                <tr>
                  <td><span class="badge">{share.platform}</span></td>
                  <td>{if share.post, do: share.post.title, else: "N/A"}</td>
                  <td class="text-sm text-gray-600">
                    {Calendar.strftime(share.inserted_at, "%B %d, %Y at %H:%M")}
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    <% end %>
  </div>
</Layouts.app>
