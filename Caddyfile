# Caddyfile for Homesite
# Caddy automatically handles HTTPS with Let's Encrypt
#
# Domains configured via environment variables:
#   PHX_HOST - primary domain (e.g., orangedinos.de)
#   PHX_ALTERNATE_HOST - secondary domain (e.g., juhahalmu.fi)

# Both domains serve the same content
{$PHX_HOST}, {$PHX_ALTERNATE_HOST} {
	# Enable compression
	encode gzip zstd

	# Serve uploaded files directly from volume
	handle /uploads/* {
		uri strip_prefix /uploads
		root * /uploads
		file_server
	}

	# Reverse proxy to Phoenix app
	handle {
		reverse_proxy app:4000 {
			# Tell Phoenix we're using HTTPS
			header_up X-Forwarded-Proto https
			# Forward WebSocket upgrade headers for LiveView
			header_up Upgrade {http.request.header.Upgrade}
			header_up Connection {http.request.header.Connection}
		}
	}

	# Security headers (supplementing Phoenix CSP)
	header {
		# Strict Transport Security
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		# Prevent MIME sniffing
		X-Content-Type-Options "nosniff"
		# XSS protection
		X-XSS-Protection "1; mode=block"
		# Prevent clickjacking
		X-Frame-Options "DENY"
		# Control referrer
		Referrer-Policy "strict-origin-when-cross-origin"
		# Remove server header
		-Server
	}

	# Logging
	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}

# Redirect www to non-www
www.{$PHX_HOST} {
	redir https://{$PHX_HOST}{uri} permanent
}

www.{$PHX_ALTERNATE_HOST} {
	redir https://{$PHX_ALTERNATE_HOST}{uri} permanent
}
