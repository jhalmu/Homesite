# Database Configuration
DB_PASSWORD=change_this_to_a_secure_password

# Phoenix Configuration
SECRET_KEY_BASE=change_this_to_a_64_character_secret_key
PHX_HOST=example.com
PHX_CHECK_ORIGIN_HOSTS=example.com,www.example.com
PHX_ALTERNATE_HOST=www.example.com

# SMTP Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=your_smtp_password

# Cloudflare Turnstile (CAPTCHA)
# Get from: https://dash.cloudflare.com/ → Turnstile
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# MaxMind GeoIP (Optional - for geolocation in analytics)
# Get from: https://www.maxmind.com/en/geolite2/signup
MAXMIND_LICENSE_KEY=your_maxmind_license_key
