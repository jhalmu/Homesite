# Homesite Environment Configuration
# Copy this file to .env and fill in the values
#
# NEVER commit .env to version control!

# =============================================================================
# REQUIRED - Generate these on the server
# =============================================================================

# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=

# Generate with: openssl rand -base64 32
DB_PASSWORD=

# Your domain (e.g., juhahalmu.fi)
PHX_HOST=

# =============================================================================
# OPTIONAL - Defaults are usually fine
# =============================================================================

# Database connection (uses DB_PASSWORD from above)
# DATABASE_URL=ecto://homesite:${DB_PASSWORD}@db/homesite_prod

# Server port (default: 4000)
# PORT=4000

# Enable server (default: true)
# PHX_SERVER=true

# =============================================================================
# EMAIL - SMTP Configuration (optional, removes "Kehitystila" notice)
# =============================================================================

# SMTP server host (e.g., mail.your-server.de for Hetzner)
SMTP_HOST=
# SMTP port (default: 587 for STARTTLS)
SMTP_PORT=587
# SMTP authentication credentials
SMTP_USERNAME=
SMTP_PASSWORD=
